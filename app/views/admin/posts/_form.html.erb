<%= form_with(model: [:admin, post], class: "row g-4") do |f| %>
  <% if post.errors.any? %>
    <div class="col-12">
      <div class="alert alert-danger rounded-4 border-0 shadow-sm">
        <h5 class="fw-bold"><%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:</h5>
        <ul class="mb-0">
          <% post.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="col-lg-8">
    <div class="card shadow-sm border-0 rounded-4 p-4 p-md-5 mb-4">
      <div class="row g-4">
        <div class="col-md-12">
          <%= f.label :title, class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <%= f.text_field :title, class: "form-control form-control-lg border-0 bg-light rounded-pill px-4 fw-bold", placeholder: "Enter post title..." %>
        </div>

        <div class="col-md-12">
          <%= f.label :slug, "URL Slug", class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <%= f.text_field :slug, class: "form-control border-0 bg-light rounded-pill px-4", placeholder: "leave-blank-to-auto-generate" %>
          <div class="form-text small opacity-50 ps-3">Custom URL path for this article</div>
        </div>

        <div class="col-12">
          <%= f.label :content, class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <div class="bg-light rounded-4 p-2">
            <%= f.rich_text_area :content, class: "form-control border-0 bg-transparent", style: "min-height: 500px;" %>
          </div>
        </div>
      </div>
    </div>

    <div class="d-flex gap-3 mt-4">
      <%= f.submit class: "btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-lg" %>
      <%= link_to "Cancel", admin_posts_path, class: "btn btn-outline-secondary btn-lg rounded-pill px-5" %>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card shadow-sm border-0 rounded-4 p-4 mb-4">
      <h6 class="fw-bold text-uppercase ls-wide small mb-4">Publishing Info</h6>
      
      <div class="mb-4">
        <%= f.label :published_at, "Publish Date & Time", class: "form-label small fw-bold text-muted" %>
        <%= f.datetime_field :published_at, class: "form-control border-0 bg-light rounded-pill px-4" %>
      </div>

      <div class="mb-0">
        <%= f.label :featured_image, class: "form-label small fw-bold text-muted d-block" %>
        <div class="p-3 bg-light rounded-4 border-2 border-dashed text-center">
          <% if post.featured_image.attached? %>
            <div class="mb-3">
              <%= image_tag post.featured_image, class: "img-fluid rounded-3 shadow-sm", style: "max-height: 150px;" %>
            </div>
          <% end %>
          <%= f.file_field :featured_image, class: "form-control border-0 bg-white rounded-pill", accept: 'image/*' %>
          <div class="mt-2 extra-small text-muted">High-res landscape image recommended</div>
        </div>
      </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 p-4 bg-primary-custom text-white">
      <h6 class="fw-bold mb-3"><i class="bi bi-info-circle me-2"></i> Editorial Tips</h6>
      <ul class="list-unstyled small mb-0 opacity-75">
        <li class="mb-3 d-flex gap-2"><i class="bi bi-check2-circle text-info"></i> Use H1/H2 tags for better SEO hierarchy.</li>
        <li class="mb-3 d-flex gap-2"><i class="bi bi-check2-circle text-info"></i> Include a high-quality featured image to boost engagement.</li>
        <li class="d-flex gap-2"><i class="bi bi-check2-circle text-info"></i> Keep the slug concise and keyword-rich.</li>
      </ul>
    </div>
  </div>
<% end %>

<style>
  .border-dashed { border-style: dashed !important; }
  .ls-wide { letter-spacing: 0.1em; }
  .extra-small { font-size: 0.7rem; }
  trix-editor { border: none !important; background: transparent !important; }
  trix-toolbar .trix-button-group { border-color: rgba(0,0,0,0.05) !important; margin-bottom: 10px !important; }
</style>
