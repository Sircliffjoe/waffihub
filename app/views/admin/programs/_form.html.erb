<%= form_with(model: [:admin, program], class: "row g-4") do |f| %>
  <% if program.errors.any? %>
    <div class="col-12">
      <div class="alert alert-danger rounded-4 border-0 shadow-sm">
        <h5 class="fw-bold"><%= pluralize(program.errors.count, "error") %> prohibited this program from being saved:</h5>
        <ul class="mb-0">
          <% program.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="col-lg-8">
    <div class="card shadow-sm border-0 rounded-4 p-4 p-md-5 mb-4">
      <div class="row g-4">
        <div class="col-md-12">
          <%= f.label :title, class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <%= f.text_field :title, class: "form-control form-control-lg border-0 bg-light rounded-pill px-4 fw-bold", placeholder: "e.g. Software Development Bootcamp" %>
        </div>

        <div class="col-md-12">
          <%= f.label :description, class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <div class="bg-light rounded-4 p-2">
            <%= f.rich_text_area :description, class: "form-control border-0 bg-transparent", style: "min-height: 400px;" %>
          </div>
        </div>
      </div>
    </div>

    <div class="d-flex gap-3 mt-4">
      <%= f.submit class: "btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-lg" %>
      <%= link_to "Cancel", admin_programs_path, class: "btn btn-outline-secondary btn-lg rounded-pill px-5" %>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card shadow-sm border-0 rounded-4 p-4 mb-4">
      <h6 class="fw-bold text-uppercase ls-wide small mb-4">Program Details</h6>
      
      <div class="mb-4">
        <%= f.label :price, class: "form-label small fw-bold text-muted" %>
        <div class="input-group">
          <span class="input-group-text border-0 bg-light rounded-start-pill ps-4">₦</span>
          <%= f.number_field :price, step: 0.01, class: "form-control border-0 bg-light rounded-end-pill px-3" %>
        </div>
      </div>

      <div class="mb-4">
        <%= f.label :duration, class: "form-label small fw-bold text-muted" %>
        <%= f.text_field :duration, class: "form-control border-0 bg-light rounded-pill px-4", placeholder: "e.g. 3 Months" %>
      </div>

      <div class="mb-4">
        <%= f.label :mode, class: "form-label small fw-bold text-muted" %>
        <%= f.select :mode, ["Physical", "Online", "Hybrid"], { include_blank: "Select Mode" }, class: "form-select border-0 bg-light rounded-pill px-4" %>
      </div>

      <div class="mb-4">
        <%= f.label :instructor, class: "form-label small fw-bold text-muted" %>
        <%= f.text_field :instructor, class: "form-control border-0 bg-light rounded-pill px-4", placeholder: "Instructor Name" %>
      </div>

      <div class="mb-0">
        <%= f.label :main_image, "Featured Image", class: "form-label small fw-bold text-muted d-block" %>
        <div class="p-3 bg-light rounded-4 border-2 border-dashed text-center">
          <% if program.main_image.attached? %>
            <div class="mb-3">
              <%= image_tag program.main_image, class: "img-fluid rounded-3 shadow-sm", style: "max-height: 150px;" %>
            </div>
          <% end %>
          <%= f.file_field :main_image, class: "form-control border-0 bg-white rounded-pill", accept: 'image/*' %>
        </div>
      </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 p-4 bg-primary-custom text-white">
      <h6 class="fw-bold mb-3"><i class="bi bi-rocket-takeoff me-2"></i> Academy Success</h6>
      <p class="small opacity-75 mb-0">High-quality descriptions and clear pricing help students make informed decisions faster. Don't forget to highlight the core learning outcomes in the description!</p>
    </div>
  </div>
<% end %>

<style>
  .border-dashed { border-style: dashed !important; }
  .ls-wide { letter-spacing: 0.1em; }
  trix-editor { border: none !important; background: transparent !important; }
  trix-toolbar .trix-button-group { border-color: rgba(0,0,0,0.05) !important; margin-bottom: 10px !important; }
</style>
