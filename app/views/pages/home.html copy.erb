<%# Hero Section %>
<section class="py-5 py-lg-7 bg-light d-flex align-items-center" style="min-height: 80vh; background: linear-gradient(135deg, rgba(52, 73, 94, 0.05) 0%, rgba(52, 152, 219, 0.05) 100%);">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6">
        <h1 class="display-3 fw-bold mb-4" style="line-height: 1.1;">Accelerating <span class="text-primary-custom">Innovation</span> in the Heart of Delta.</h1>
        <p class="lead text-muted mb-5 pe-lg-5">WaffiHub is your gateway to the digital economy. We provide the ecosystem, tools, and talent to build the future of Nigerian tech.</p>
        <div class="d-flex flex-wrap gap-3">
          <%= link_to "View Programs", programs_path, class: "btn btn-primary btn-lg rounded-pill px-5 py-3 shadow-lg" %>
          <%= link_to "Explore Services", services_path, class: "btn btn-outline-primary btn-lg rounded-pill px-5 py-3" %>
        </div>
      </div>
      <div class="col-lg-6 mt-5 mt-lg-0">
        <div class="position-relative">
          <div class="rounded-4 shadow-2xl overflow-hidden shadow-lg">
               <img src="https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&q=80&w=1200" class="img-fluid" alt="Tech Hub">
          </div>
          <div class="bg-white p-4 rounded-3 shadow-lg position-absolute bottom-0 start-0 mb-4 ms-n4 d-none d-md-block" style="width: 250px;">
            <div class="d-flex align-items-center mb-2">
              <span class="badge bg-success rounded-circle p-1 me-2"><i class="bi bi-check text-white"></i></span>
              <span class="small fw-semibold">Dynamic Community</span>
            </div>
            <p class="small text-muted mb-0">Join 500+ developers and innovators in our network.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%# Services Section %>
<section class="py-5 py-lg-6 border-bottom">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="fw-bold h1">What We Do</h2>
      <p class="text-muted">Specialized solutions for startups, SMEs, and government.</p>
    </div>
    <div class="row g-4 justify-content-center">
      <% @featured_services.each do |service| %>
        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm p-3">
            <div class="card-body">
              <div class="mb-4 text-primary-custom fs-1">
                <i class="bi bi-rocket-takeoff"></i>
              </div>
              <h4 class="fw-bold mb-3"><%= service.title %></h4>
              <p class="text-muted small"><%= truncate(strip_tags(service.description.to_s), length: 120) %></p>
              <%= link_to "Learn More", service_path(service), class: "text-decoration-none fw-semibold small" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# Programs Section %>
<section class="py-5 py-lg-6 bg-primary-custom text-white overflow-hidden">
  <div class="container position-relative">
    <div class="row align-items-center mb-5">
      <div class="col-md-8">
        <h2 class="fw-bold h1 text-white">Our Top Programs</h2>
        <p class="text-white-50">Upskill your future with our specialized training paths.</p>
      </div>
      <div class="col-md-4 text-md-end">
        <%= link_to "All Programs", programs_path, class: "btn btn-outline-light rounded-pill px-4" %>
      </div>
    </div>
    
    <div class="row g-4">
      <% @featured_programs.each do |program| %>
        <div class="col-lg-4">
          <div class="card bg-white h-100 border-0 shadow text-dark overflow-hidden">
            <% if program.main_image.attached? %>
              <%= image_tag program.main_image, class: "card-img-top", style: "height: 200px; object-fit: cover;" %>
            <% end %>
            <div class="card-body p-4">
              <span class="badge bg-primary mb-3"><%= program.mode %></span>
              <h4 class="fw-bold"><%= program.title %></h4>
              <p class="text-muted small m-0"><%= program.duration %> Duration</p>
              <div class="d-flex justify-content-between align-items-center mt-4">
                <span class="h5 fw-bold mb-0 text-primary-custom"><%= number_to_currency(program.price, unit: "₦") %></span>
                <%= link_to "Enroll Now", program_path(program), class: "btn btn-primary btn-sm rounded-pill px-3" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

