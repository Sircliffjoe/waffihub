<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "Services", admin_services_path %></li>
    <li class="breadcrumb-item active"><%= @service.title %></li>
  </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
  <h1 class="h3"><%= @service.title %></h1>
  <div>
    <%= link_to "Edit", edit_admin_service_path(@service), class: "btn btn-primary" %>
    <%= link_to "Back", admin_services_path, class: "btn btn-outline-secondary ms-2" %>
  </div>
</div>

<div class="row">
  <div class="col-md-8">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body">
        <h5 class="card-title text-muted mb-3">Description</h5>
        <div class="rich-text-content">
          <%= @service.description %>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card shadow-sm border-0">
      <div class="card-body">
        <h5 class="card-title text-muted mb-3">Service Details</h5>
        <p><strong>Category:</strong> <%= @service.category %></p>
        <p><strong>Pricing:</strong> <%= @service.pricing.present? ? number_to_currency(@service.pricing, unit: "₦") : "Contact for pricing" %></p>
      </div>
    </div>
  </div>
</div>
