<%= form_with(model: [:admin, team_member], class: "row g-3") do |f| %>
  <div class="col-md-6">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>
  <div class="col-md-6">
    <%= f.label :role, class: "form-label" %>
    <%= f.text_field :role, class: "form-control" %>
  </div>
  <div class="col-12">
    <%= f.label :image, class: "form-label" %>
    <%= f.file_field :image, class: "form-control" %>
  </div>
  <div class="col-12">
    <%= f.label :bio, class: "form-label" %>
    <%= f.rich_text_area :bio, class: "form-control", style: "min-height: 200px;" %>
  </div>
  <div class="col-12 mt-4">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_team_members_path, class: "btn btn-outline-secondary ms-2" %>
  </div>
<% end %>
