<%= form_with(model: [:admin, team_member], class: "row g-4") do |f| %>
  <% if team_member.errors.any? %>
    <div class="col-12">
      <div class="alert alert-danger rounded-4 border-0 shadow-sm">
        <h5 class="fw-bold"><%= pluralize(team_member.errors.count, "error") %> prohibited this member from being saved:</h5>
        <ul class="mb-0">
          <% team_member.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="col-lg-8">
    <div class="card shadow-sm border-0 rounded-4 p-4 p-md-5 mb-4">
      <div class="row g-4">
        <div class="col-md-6">
          <%= f.label :name, class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <%= f.text_field :name, class: "form-control form-control-lg border-0 bg-light rounded-pill px-4 fw-bold", placeholder: "Full Name" %>
        </div>

        <div class="col-md-6">
          <%= f.label :role, class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <%= f.text_field :role, class: "form-control form-control-lg border-0 bg-light rounded-pill px-4", placeholder: "e.g. Managing Director" %>
        </div>

        <div class="col-12">
          <%= f.label :bio, class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <div class="bg-light rounded-4 p-2">
            <%= f.rich_text_area :bio, class: "form-control border-0 bg-transparent", style: "min-height: 300px;" %>
          </div>
        </div>
      </div>
    </div>

    <div class="d-flex gap-3 mt-4">
      <%= f.submit class: "btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-lg" %>
      <%= link_to "Cancel", admin_team_members_path, class: "btn btn-outline-secondary btn-lg rounded-pill px-5" %>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card shadow-sm border-0 rounded-4 p-4 mb-4">
      <h6 class="fw-bold text-uppercase ls-wide small mb-4">Profile Image</h6>
      
      <div class="mb-0">
        <div class="p-3 bg-light rounded-4 border-2 border-dashed text-center">
          <% if team_member.image.attached? %>
            <div class="mb-3">
              <%= image_tag team_member.image, class: "rounded-circle border shadow-sm", style: "width: 150px; height: 150px; object-fit: cover;" %>
            </div>
          <% end %>
          <%= f.file_field :image, class: "form-control border-0 bg-white rounded-pill", accept: 'image/*' %>
          <div class="mt-2 extra-small text-muted">Square portrait recommended</div>
        </div>
      </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 p-4 bg-primary-custom text-white">
      <h6 class="fw-bold mb-3"><i class="bi bi-person-badge me-2"></i> Team Identity</h6>
      <p class="small opacity-75 mb-0">Adding a professional bio and a clear profile picture helps humanize the hub and build trust with partners and students.</p>
    </div>
  </div>
<% end %>

<style>
  .border-dashed { border-style: dashed !important; }
  .ls-wide { letter-spacing: 0.1em; }
  .extra-small { font-size: 0.7rem; }
  trix-editor { border: none !important; background: transparent !important; }
  trix-toolbar .trix-button-group { border-color: rgba(0,0,0,0.05) !important; margin-bottom: 10px !important; }
</style>
