<%# HERO SECTION %>
<section class="position-relative py-10 py-lg-12 overflow-hidden bg-primary-custom text-white">
  <div class="position-absolute top-0 start-0 w-100 h-100 opacity-25 z-0">
    <% if @service.image.attached? %>
      <%= image_tag @service.image, class: "w-100 h-100", style: "object-fit: cover; filter: brightness(0.4);", alt: @service.title %>
    <% end %>
  </div>
  
  <div class="container position-relative z-1 py-5">
    <nav aria-label="breadcrumb" class="mb-5">
       <%= link_to "<i class='bi bi-arrow-left me-2'></i>Back to Services".html_safe, services_path, class: "text-white-50 text-decoration-none fw-bold small text-uppercase ls-wide hover-white transition-all" %>
    </nav>

    <div class="row align-items-center">
      <div class="col-lg-8" data-aos="fade-right">
        <% if @service.category.present? %>
          <div class="d-inline-block bg-white bg-opacity-10 rounded-pill px-4 py-2 mb-4">
            <span class="text-info fw-bold text-uppercase small ls-wide">
              <% if @service.icon.present? %>
                <i class="bi bi-<%= @service.icon %> me-2"></i>
              <% end %>
              <%= @service.category %>
            </span>
          </div>
        <% end %>
        
        <h1 class="display-3 fw-bold mb-4 text-white"><%= @service.title %></h1>
        
        <% if @service.pricing.present? && @service.pricing > 0 %>
          <div class="d-inline-flex align-items-center bg-white text-primary-custom rounded-pill px-4 py-2 shadow-lg mb-5">
            <i class="bi bi-tag-fill me-2 text-info"></i>
            <span class="fw-bold h5 mb-0">Starting from <%= number_to_currency(@service.pricing, unit: "₦") %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>

<%# MAIN CONTENT & GALLERY %>
<section class="py-10 bg-light">
  <div class="container">
    <div class="row g-5">
      
      <%# LEFT COLUMN - DESCRIPTION %>
      <div class="col-lg-<%= @service.images.attached? ? '7' : '10 mx-auto' %>" data-aos="fade-up">
        <div class="card border-0 shadow-sm rounded-5 overflow-hidden">
          <div class="card-body p-4 p-md-5 bg-white">
            <h3 class="fw-bold mb-4 text-primary-custom">Service Overview</h3>
            <div class="rich-text-content lead text-muted" style="line-height: 1.8;">
              <%= @service.description %>
            </div>
          </div>
        </div>
      </div>

      <%# RIGHT COLUMN - GALLERY %>
      <% if @service.images.attached? %>
        <div class="col-lg-5" data-aos="fade-left" data-aos-delay="100">
          <h4 class="fw-bold mb-4 text-primary-custom" style="margin-top: 50px;">Service Gallery</h4>
          <div class="row g-3">
            <% @service.images.each_with_index do |image, index| %>
              <div class="col-6">
                <a href="<%= url_for(image) %>" data-fslightbox="gallery" class="d-block rounded-4 overflow-hidden shadow-sm hover-lift transition-all group-hover">
                  <%= image_tag image, class: "img-fluid w-100", style: "height: 200px; object-fit: cover; transition: transform 0.3s ease;", alt: "Gallery Image #{index + 1}" %>
                </a>
              </div>
            <% end %>
          </div>
          <div class="mt-4 p-4 bg-white rounded-4 shadow-sm border-start border-4 border-info">
            <p class="small text-muted mb-0 fw-semibold"><i class="bi bi-info-circle-fill text-info me-2"></i> Our services are tailored to meet your unique business needs. The gallery showcases our commitment to quality and excellence.</p>
          </div>
        </div>
      <% end %>

    </div>
  </div>
</section>

<% if @plans.present? %>
  <%# Pricing Section %>
  <section class="py-10 bg-light border-top border-bottom">
    <div class="container">
      <div class="text-center mb-8" data-aos="fade-up" style="margin-top: 120px;">
         <h6 class="text-primary-custom fw-bold text-uppercase ls-wide mb-2">Work with comfort</h6>
        <h2 class="display-5 fw-bold mb-3 text-primary-custom">Co-working Hub Subscriptions</h2>
        <p class="lead text-muted mx-auto" style="max-width: 750px; margin-bottom: 40px;">High-speed connectivity and modern amenities tailored for independent creators and expanding teams.</p>
      </div>
      
      <div class="row g-5 justify-content-center">
        <% @plans.each_with_index do |plan, i| %>
          <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="<%= i * 100 %>">
            <div class="card h-100 border-0 shadow-lg rounded-5 overflow-hidden transition-hover <%= 'border-top border-5 border-info' if plan.highlight %>">
              <div class="p-5 text-center <%= plan.highlight ? 'bg-primary-custom text-white' : 'bg-white' %>">
                <h4 class="fw-bold mb-3 <%= 'text-white' if plan.highlight %>"><%= plan.name %></h4>
                <div class="display-6 fw-bold mb-0">₦ <%= number_with_delimiter(plan.price.to_i) %><span class="fs-6 <%= plan.highlight ? 'text-white-50' : 'text-muted' %>"> / <%= plan.interval %></span></div>
                <% if plan.highlight %>
                  <span class="badge bg-warning text-dark mt-2 text-uppercase fw-bold p-2 px-3">Most Popular</span>
                <% end %>
              </div>
              <div class="card-body p-5 bg-white">
                <ul class="list-unstyled mb-5">
                  <% (plan.features || []).each do |feature| %>
                    <li class="mb-3 d-flex align-items-center">
                      <div class="bg-success bg-opacity-10 text-success rounded-circle p-1 me-3 d-flex align-items-center justify-content-center" style="width: 24px; height: 24px;">
                        <i class="bi bi-check-lg small fw-bold"></i>
                      </div>
                      <span class="text-muted text-start"><%= feature %></span>
                    </li>
                  <% end %>
                </ul>
                <%= button_to "Book Now", bookings_path(plan_id: plan.id), method: :post, class: "btn #{plan.highlight ? 'btn-primary' : 'btn-outline-primary'} w-100 rounded-pill py-3 fw-bold shadow-sm transition-all" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<%# CALL TO ACTION %>
<section class="py-10 bg-white border-top" style="margin-top: 120px;">
  <div class="container text-center" style="margin-bottom: 100px;" data-aos="zoom-in">
    <div class="max-w-700 mx-auto">
      <div class="icon-box-lg bg-light text-primary-custom mx-auto rounded-circle mb-4 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 2rem;">
        <i class="bi bi-chat-quote-fill"></i>
      </div>
      <h2 class="display-5 fw-bold text-primary-custom mb-3">Ready to Transform Your Business?</h2>
      <p class="lead text-muted mb-5">Get in touch with our experts to discuss how <strong><%= @service.title %></strong> can drive your success forward.</p>
      
      <%= link_to contact_path(subject: "Inquiry about #{@service.title}"), class: "btn btn-primary btn-lg rounded-pill px-5 py-3 fw-bold shadow-lg hover-lift transition-all d-inline-flex align-items-center gap-2" do %>
        <span>Request a Free Quote</span>
        <i class="bi bi-arrow-right"></i>
      <% end %>
    </div>
  </div>
</section>

<style>
  .ls-wide { letter-spacing: 0.1em; }
  .hover-white:hover { color: white !important; }
  .transition-all { transition: all 0.3s ease; }
  .hover-lift:hover { transform: translateY(-5px); }
  .max-w-700 { max-width: 700px; }
  .group-hover:hover img { transform: scale(1.05); }
  
  /* Rich text styling enhancements */
  .rich-text-content h1, .rich-text-content h2, .rich-text-content h3 { color: var(--bs-primary-custom, #1A2B3C); font-weight: bold; margin-top: 1.5rem; margin-bottom: 1rem; }
  .rich-text-content ul, .rich-text-content ol { padding-left: 1.5rem; margin-bottom: 1.5rem; }
  .rich-text-content li { margin-bottom: 0.5rem; }
  .rich-text-content a { color: var(--bs-info); text-decoration: none; font-weight: 500; }
  .rich-text-content a:hover { text-decoration: underline; }
</style>
