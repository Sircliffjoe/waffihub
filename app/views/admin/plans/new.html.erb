<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 fw-bold text-dark mb-0">New Pricing Plan</h1>
  <%= link_to admin_plans_path, class: "btn btn-light rounded-pill px-4 shadow-sm fw-bold border d-flex align-items-center text-dark" do %>
    <i class="bi bi-arrow-left me-2"></i> Back to Plans
  <% end %>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
  <div class="card-header bg-white border-bottom py-3">
    <h5 class="card-title fw-bold text-dark mb-0 d-flex align-items-center">
      <i class="bi bi-tags text-primary-custom me-2"></i> Plan Configuration
    </h5>
  </div>
  <div class="card-body p-4 p-lg-5 bg-light bg-opacity-50">
    <%= render "form", plan: @plan %>
  </div>
</div>
