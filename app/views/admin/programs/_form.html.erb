<%= form_with(model: [:admin, program], class: "row g-3") do |f| %>
  <% if program.errors.any? %>
    <div class="col-12">
      <div class="alert alert-danger">
        <h4><%= pluralize(program.errors.count, "error") %> prohibited this program from being saved:</h4>
        <ul>
          <% program.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="col-md-6">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-control" %>
  </div>

  <div class="col-md-3">
    <%= f.label :price, class: "form-label" %>
    <div class="input-group">
      <span class="input-group-text">₦</span>
      <%= f.number_field :price, step: 0.01, class: "form-control" %>
    </div>
  </div>

  <div class="col-md-3">
    <%= f.label :duration, class: "form-label" %>
    <%= f.text_field :duration, class: "form-control", placeholder: "e.g. 3 Months" %>
  </div>

  <div class="col-md-6">
    <%= f.label :mode, class: "form-label" %>
    <%= f.select :mode, ["Physical", "Online", "Hybrid"], { include_blank: "Select Mode" }, class: "form-select" %>
  </div>

  <div class="col-md-6">
    <%= f.label :instructor, class: "form-label" %>
    <%= f.text_field :instructor, class: "form-control" %>
  </div>

  <div class="col-12">
    <%= f.label :main_image, "Featured Image", class: "form-label" %>
    <%= f.file_field :main_image, class: "form-control" %>
  </div>

  <div class="col-12">
    <%= f.label :description, class: "form-label" %>
    <%= f.rich_text_area :description, class: "form-control", style: "min-height: 200px;" %>
  </div>

  <div class="col-12 mt-4">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_programs_path, class: "btn btn-outline-secondary ms-2" %>
  </div>
<% end %>
