<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3">News & Blog Posts</h1>
  <%= link_to "New Post", new_admin_post_path, class: "btn btn-primary" %>
</div>

<div class="card shadow-sm border-0">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="bg-light">
        <tr>
          <th>Title</th>
          <th>Published At</th>
          <th>Slug</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @posts.each do |post| %>
          <tr>
            <td class="fw-bold"><%= post.title %></td>
            <td><%= post.published_at&.strftime("%B %d, %Y") %></td>
            <td><code><%= post.slug %></code></td>
            <td class="text-end">
              <%= link_to "View", admin_post_path(post), class: "btn btn-outline-info btn-sm" %>
              <%= link_to "Edit", edit_admin_post_path(post), class: "btn btn-outline-primary btn-sm" %>
              <%= button_to "Delete", admin_post_path(post), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-outline-danger btn-sm d-inline-block" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
