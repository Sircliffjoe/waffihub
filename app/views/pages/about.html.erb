<%# 1. PROFESSIONAL HERO SECTION %>
<section class="position-relative py-9 py-lg-10 overflow-hidden bg-primary-custom text-white">
  <div class="position-absolute top-0 start-0 w-100 h-100 opacity-50">
    <%= image_tag "about_hero.png", class: "w-100 h-100", style: "object-fit: cover; filter: brightness(0.4);" %>
  </div>
  <div class="container position-relative z-1 py-9">
    <div class="row justify-content-center text-center">
      <div class="col-lg-8" data-aos="fade-up">
        <h6 class="text-white-50 fw-bold text-uppercase ls-wide mb-3" style="margin-top:50px;">Our Identity</h6>
        <h1 class="display-3 fw-bold mb-4 text-white">At a <span class="text-info">Glance</span>.</h1>
        <p class="lead text-white-50" style="margin-bottom:50px;">WaffiHub is more than a coworking space. We are a startup ecosystem dedicated to building the future of Nigeria's digital economy from the heart of Delta.</p>
      </div>
    </div>
  </div>
</section>

<%# 2. OUR STORY & MISSION SECTION %>
<section class="py-8 bg-white" id="mission">
  <div class="container">
    <div class="row g-5 align-items-center">
      <div class="col-lg-6" data-aos="fade-right">
        <div class="pe-lg-5">
          <h2 class="display-5 fw-bold mb-4">Our Journey</h2>
          <p class="text-muted lead mb-4">Founded with a vision to transform the tech landscape in Warri, Delta State, WaffiHub Limited has grown into a premier destination for talent development and business incubation.</p>
          <div class="row g-4 mt-2">
            <div class="col-sm-6">
              <div class="p-4 bg-light rounded-4 border-start border-4 border-primary-custom">
                <h4 class="fw-bold mb-2">Our Mission</h4>
                <p class="small text-muted mb-0">To create an enabling environment for tech innovation and entrepreneurship to thrive in the Niger Delta.</p>
              </div>
            </div>
            <div class="col-sm-6">
              <div class="p-4 bg-light rounded-4 border-start border-4 border-info">
                <h4 class="fw-bold mb-2">Our Vision</h4>
                <p class="small text-muted mb-0">To be the leading catalyst for digital transformation and economic empowerment in Southern Nigeria.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-lg-6" data-aos="fade-left">
        <div class="rounded-5 overflow-hidden shadow-2xl position-relative">
          <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&q=80&w=1200" class="img-fluid" alt="Our Team Culture">
          <div class="position-absolute bottom-0 end-0 p-4 bg-primary-custom text-white rounded-start-4 d-none d-md-block">
             <div class="h3 fw-bold mb-0">Focus on Impact.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%# 3. CORE VALUES SECTION %>
<section class="py-8 bg-light overflow-hidden">
  <div class="container">
    <div class="text-center mb-7" data-aos="fade-up">
      <h6 class="text-primary-custom fw-bold text-uppercase ls-wide mb-2">Principles</h6>
      <h2 class="display-5 fw-bold mb-3">Our Core Values</h2>
      <p class="lead text-muted mx-auto" style="max-width: 700px;">The pillars that guide our interactions, services, and community growth.</p>
    </div>

    <div class="row g-5">
      <% [
        { icon: "people", title: "Community First", desc: "We believe in the power of shared knowledge and collaborative growth." },
        { icon: "lightning-charge", title: "Continuous Innovation", desc: "Staying at the edge of technology to provide relevant solutions." },
        { icon: "shield-check", title: "Integrity & Trust", desc: "Building honest relationships with our founders, partners, and students." },
        { icon: "gem", title: "Excellence", desc: "Pushing the boundaries of what's possible in every project we touch." }
      ].each_with_index do |value, i| %>
        <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="<%= i * 100 %>">
          <div class="card h-100 border-0 shadow-sm transition-hover p-5 text-center rounded-5 bg-white">
            <div class="icon-box-sm bg-primary-custom bg-opacity-10 text-white mb-4 mx-auto rounded-4">
              <i class="bi bi-<%= value[:icon] %>"></i>
            </div>
            <h5 class="fw-bold mb-3"><%= value[:title] %></h5>
            <p class="text-muted small mb-0"><%= value[:desc] %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# 4. TEAM SECTION %>
<section class="py-8 bg-white" id="team">
  <div class="container">
    <div class="text-center mb-7" data-aos="fade-up">
      <h6 class="text-primary-custom fw-bold text-uppercase ls-wide mb-2">The Brains</h6>
      <h2 class="display-5 fw-bold mb-3">Our Leadership Team</h2>
      <p class="lead text-muted mx-auto" style="max-width: 700px;">Meet the dedicated professionals driving the vision of WaffiHub Forward.</p>
    </div>

    <div class="row g-5">
      <% @team_members.each_with_index do |member, i| %>
        <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="<%= i * 100 %>">
          <div class="card h-100 border-0 shadow-sm text-center p-5 rounded-5 transition-hover">
            <div class="position-relative mb-4 mx-auto" style="width: 180px; height: 180px;">
              <% if member.image.attached? %>
                <%= image_tag member.image, class: "rounded-circle w-100 h-100", style: "object-fit: cover;" %>
              <% else %>
                <%
                  fallback_img = case member.name
                                 when /Emeka/i then 'ceo_headshot.png'
                                 when /Sarah/i then 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&q=80&w=400'
                                 else 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&q=80&w=400'
                                 end
                %>
                <%= image_tag fallback_img, class: "rounded-circle w-100 h-100", style: "object-fit: cover;" %>
              <% end %>
              <div class="position-absolute bottom-0 end-0 bg-primary-custom text-white p-2 rounded-circle shadow-sm">
                <i class="bi bi-linkedin fs-6"></i>
              </div>
            </div>
            <h4 class="fw-bold mb-1"><%= member.name %></h4>
            <p class="text-primary-custom fw-semibold small mb-4"><%= member.role %></p>
            <p class="text-muted small mb-0"><%= member.bio %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# 5. CTA SECTION %>
<section class="py-8 bg-primary-custom text-white overflow-hidden text-center position-relative">
  <div class="container position-relative z-1">
    <h2 class="display-4 fw-bold mb-4 text-white">Ready to Innovate with Us?</h2>
    <p class="lead text-white-50 mb-5 mx-auto" style="max-width: 700px;">Join our community of over 500+ builders, creators, and entrepreneurs scaling tech solutions from the Niger Delta.</p>
    <div class="d-flex flex-wrap justify-content-center gap-3">
      <%= link_to "Join Our Workspace", root_path(anchor: 'pricing'), class: "btn btn-info btn-lg rounded-pill px-5 py-3 fw-bold" %>
      <%= link_to "Partner With Us", contact_path, class: "btn btn-outline-light btn-lg rounded-pill px-5 py-3 fw-bold" %>
    </div>
  </div>
</section>
