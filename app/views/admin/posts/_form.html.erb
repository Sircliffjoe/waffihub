<%= form_with(model: [:admin, post], class: "row g-3") do |f| %>
  <% if post.errors.any? %>
    <div class="col-12">
      <div class="alert alert-danger">
        <h4><%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:</h4>
        <ul>
          <% post.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="col-md-8">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-control fw-bold" %>
  </div>

  <div class="col-md-4">
    <%= f.label :published_at, class: "form-label" %>
    <%= f.datetime_field :published_at, class: "form-control" %>
  </div>

  <div class="col-md-12">
    <%= f.label :slug, class: "form-label" %>
    <%= f.text_field :slug, class: "form-control", placeholder: "Leave blank to auto-generate" %>
  </div>

  <div class="col-12">
    <%= f.label :featured_image, class: "form-label" %>
    <%= f.file_field :featured_image, class: "form-control" %>
  </div>

  <div class="col-12">
    <%= f.label :content, class: "form-label" %>
    <%= f.rich_text_area :content, class: "form-control", style: "min-height: 400px;" %>
  </div>

  <div class="col-12 mt-4">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_posts_path, class: "btn btn-outline-secondary ms-2" %>
  </div>
<% end %>
