<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 fw-bold text-dark mb-0">Services</h1>
  <%= link_to new_admin_service_path, class: "btn btn-primary rounded-pill px-4 shadow-sm fw-bold" do %>
    <i class="bi bi-plus-circle me-1"></i> New Service
  <% end %>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0 border-0">
      <thead class="bg-light">
        <tr>
          <th class="py-3 px-4 text-muted fw-bold text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.05em;">Title</th>
          <th class="py-3 px-4 text-muted fw-bold text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.05em;">Category</th>
          <th class="py-3 px-4 text-muted fw-bold text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.05em;">Pricing</th>
          <th class="py-3 px-4 text-muted fw-bold text-uppercase text-end" style="font-size: 0.8rem; letter-spacing: 0.05em;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @services.each do |service| %>
          <tr>
            <td class="px-4 py-3">
              <div class="d-flex align-items-center">
                <div class="icon-box-sm bg-primary-custom bg-opacity-10 text-primary-custom rounded-3 me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                  <i class="bi bi-<%= service.icon.presence || 'rocket-takeoff' %>"></i>
                </div>
                <span class="fw-bold text-dark"><%= service.title %></span>
              </div>
            </td>
            <td class="px-4 py-3">
              <span class="badge bg-light text-primary-custom border rounded-pill px-3 py-2 fw-semibold">
                <%= service.category.presence || "Uncategorized" %>
              </span>
            </td>
            <td class="px-4 py-3 text-muted fw-semibold">
              <%= service.pricing.present? ? number_to_currency(service.pricing, unit: "₦") : "Contact for price" %>
            </td>
            <td class="px-4 py-3 text-end">
              <div class="btn-group border rounded-pill overflow-hidden shadow-sm">
                <%= link_to admin_service_path(service), class: "btn btn-light btn-sm text-info fw-bold border-0 px-3", title: "View" do %>
                  <i class="bi bi-eye"></i> View
                <% end %>
                <%= link_to edit_admin_service_path(service), class: "btn btn-light btn-sm text-primary-custom fw-bold border-0 px-3 border-start", title: "Edit" do %>
                  <i class="bi bi-pencil"></i> Edit
                <% end %>
                <%= button_to admin_service_path(service), method: :delete, data: { confirm: "Are you sure you want to delete this service?" }, class: "btn btn-light btn-sm text-danger fw-bold border-0 px-3 border-start", title: "Delete" do %>
                  <i class="bi bi-trash"></i> Delete
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
