<!DOCTYPE html>
<html>
  <head>
    <title>WaffiHub | Management Center</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Enable PWA manifest for installable apps (ensure config/routes.rb has the route) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path %>

    <link rel="icon" type="image/png" href="<%= asset_path('icon.png') %>">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <style>
      :root {
        --sidebar-width: 280px;
        --sidebar-bg: #1a1c1e;
        --sidebar-color: #94a3b8;
        --sidebar-active-bg: #2d3339;
        --sidebar-active-color: #ffffff;
      }

      body {
        background-color: #f8fafc;
        overflow-x: hidden;
      }

      /* Sidebar Structure */
      .admin-wrapper {
        min-height: 100vh;
      }

      .admin-sidebar {
        width: var(--sidebar-width);
        background-color: var(--sidebar-bg);
        color: var(--sidebar-color);
        position: fixed;
        height: 100vh;
        z-index: 1000;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        border-right: 1px solid rgba(255,255,255,0.05);
        overflow-y: auto; /* Enable vertical scrolling */
        scrollbar-width: thin; /* Firefox */
        scrollbar-color: #2d3339 transparent;
      }

      .admin-sidebar::-webkit-scrollbar {
        width: 6px;
      }
      .admin-sidebar::-webkit-scrollbar-thumb {
        background-color: #2d3339;
        border-radius: 10px;
      }

      .admin-content {
        margin-left: var(--sidebar-width);
        width: calc(100% - var(--sidebar-width));
        padding: 2.5rem;
        transition: all 0.3s ease;
      }

      /* Navigation Items */
      .nav-group-title {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #475569;
        margin: 1.5rem 1.5rem 0.75rem;
      }

      .sidebar-link {
        display: flex;
        align-items: center;
        padding: 0.75rem 1.5rem;
        color: var(--sidebar-color);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: all 0.2s;
        border-right: 3px solid transparent;
      }

      .sidebar-link i {
        font-size: 1.1rem;
        margin-right: 0.75rem;
        width: 20px;
        text-align: center;
      }

      .sidebar-link:hover {
        background-color: var(--sidebar-active-bg);
        color: var(--sidebar-active-color);
      }

      .sidebar-link.active {
        background-color: var(--sidebar-active-bg);
        color: var(--sidebar-active-color);
        border-right-color: #3b82f6;
      }

      /* Logo Area */
      .sidebar-brand {
        padding: 2rem 1.5rem;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        margin-bottom: 1rem;
      }

      /* User Badge */
      .sidebar-user {
        margin-top: auto;
        padding: 1.5rem;
        background-color: rgba(0,0,0,0.2);
        border-top: 1px solid rgba(255,255,255,0.05);
      }

      /* Trix Editor Fixes */
      trix-toolbar {
        border-bottom: 1px solid rgba(0,0,0,0.05) !important;
        padding: 10px 0 !important;
        margin-bottom: 10px !important;
      }
      trix-toolbar .trix-button-group {
        border: 1px solid #e2e8f0 !important;
        border-radius: 8px !important;
        margin-bottom: 5px !important;
        background: white !important;
        overflow: hidden;
        display: flex;
        flex-wrap: wrap;
      }
      trix-toolbar .trix-button {
        border: none !important;
        border-right: 1px solid #e2e8f0 !important;
        background: white !important;
        padding: 8px 12px !important;
        font-size: 0.85rem !important;
        font-weight: 600 !important;
        color: #64748b !important;
      }
      trix-toolbar .trix-button:last-child { border-right: none !important; }
      trix-toolbar .trix-button:hover { background: #f8fafc !important; color: #3b82f6 !important; }
      trix-toolbar .trix-button--active { background: #eff6ff !important; color: #3b82f6 !important; }
      
      /* Force toolbar to wrap instead of stretching */
      trix-toolbar .trix-button-row {
        display: flex !important;
        flex-wrap: wrap !important;
        gap: 5px !important;
      }

      /* Hide text labels on buttons that should have icons, or just ensure they wrap */
      trix-editor {
        border: none !important;
        outline: none !important;
        padding: 1rem !important;
        min-height: 300px;
        color: #334155 !important;
        line-height: 1.6 !important;
      }

      /* Hide text labels and show only icons */
      trix-toolbar .trix-button {
        font-size: 0 !important; /* Hide text */
        width: 44px !important;
        height: 44px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        position: relative !important;
      }
      
      /* Ensure icons are visible and centered */
      trix-toolbar .trix-button::before {
        font-size: 1.1rem !important;
        color: inherit !important;
      }

      /* Fix for Trix's specific icon buttons */
      trix-toolbar .trix-button--icon-bold::before { content: "B" !important; font-weight: 900 !important; font-size: 1rem !important; }
      trix-toolbar .trix-button--icon-italic::before { content: "I" !important; font-style: italic !important; font-size: 1rem !important; }
      trix-toolbar .trix-button--icon-strike::before { content: "S" !important; text-decoration: line-through !important; font-size: 1rem !important; }
      trix-toolbar .trix-button--icon-link::before { content: "\f207" !important; font-family: "bootstrap-icons" !important; }
      trix-toolbar .trix-button--icon-heading-1::before { content: "H" !important; font-size: 1.1rem !important; }
      trix-toolbar .trix-button--icon-quote::before { content: "\f491" !important; font-family: "bootstrap-icons" !important; }
      trix-toolbar .trix-button--icon-code::before { content: "\f2c8" !important; font-family: "bootstrap-icons" !important; }
      trix-toolbar .trix-button--icon-bullet-list::before { content: "\f46d" !important; font-family: "bootstrap-icons" !important; }
      trix-toolbar .trix-button--icon-number-list::before { content: "\f48a" !important; font-family: "bootstrap-icons" !important; }
      trix-toolbar .trix-button--icon-undo::before { content: "\f12a" !important; font-family: "bootstrap-icons" !important; }
      trix-toolbar .trix-button--icon-redo::before { content: "\f22d" !important; font-family: "bootstrap-icons" !important; }
      trix-toolbar .trix-button--icon-decrease-nesting-level::before { content: "\f12d" !important; font-family: "bootstrap-icons" !important; }
      trix-toolbar .trix-button--icon-increase-nesting-level::before { content: "\f12e" !important; font-family: "bootstrap-icons" !important; }
      trix-toolbar .trix-button--icon-attach::before { content: "\f4f0" !important; font-family: "bootstrap-icons" !important; }
      .admin-content {
        margin-left: var(--sidebar-width);
        width: calc(100% - var(--sidebar-width));
        padding: 2.5rem;
        transition: all 0.3s ease;
        min-height: 100vh;
      }

      /* Mobile Header */
      .admin-mobile-header {
        display: none;
        background-color: var(--sidebar-bg);
        color: white;
        padding: 0.75rem 1.25rem;
        position: sticky;
        top: 0;
        z-index: 1010;
        border-bottom: 1px solid rgba(255,255,255,0.05);
      }

      @media (max-width: 992px) {
        .admin-sidebar { 
          margin-left: calc(-1 * var(--sidebar-width)); 
          height: 100%;
          position: fixed;
        }
        .admin-content { 
          margin-left: 0 !important; 
          width: 100% !important;
          padding: 1.25rem !important; 
        }
        .admin-sidebar.show { 
          margin-left: 0 !important; 
        }
        .admin-mobile-header {
          display: flex;
          align-items: center;
          justify-content: space-between;
          height: 60px;
        }
        /* Overlay when sidebar is open */
        .sidebar-overlay {
          display: none;
          position: fixed;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          background: rgba(0,0,0,0.6);
          backdrop-filter: blur(4px);
          z-index: 999;
        }
        .sidebar-overlay.show {
          display: block;
        }

        /* Stack buttons on mobile */
        .admin-content .d-flex.gap-2, 
        .admin-content .d-flex.gap-3 {
          flex-direction: column !important;
        }
        .admin-content .d-flex.gap-2 > *, 
        .admin-content .d-flex.gap-3 > * {
          width: 100% !important;
          margin-bottom: 0.5rem !important;
          justify-content: center !important;
        }
        .admin-content h1.h2 {
          font-size: 1.5rem !important;
        }
      }
    </style>
  </head>
 
  <body>
    <div class="admin-wrapper">
      <div class="admin-mobile-header px-3">
        <h5 class="text-white fw-bold mb-0">WaffiHub <span class="text-info">CMS</span></h5>
        <button class="btn btn-dark border-0 rounded-circle" onclick="document.querySelector('.admin-sidebar').classList.toggle('show'); document.querySelector('.sidebar-overlay').classList.toggle('show');">
          <i class="bi bi-list fs-4"></i>
        </button>
      </div>
      <div class="sidebar-overlay" onclick="document.querySelector('.admin-sidebar').classList.remove('show'); this.classList.remove('show');"></div>

      <%# SIDEBAR %>
      <aside class="admin-sidebar shadow-lg">
        <div class="sidebar-brand">
          <h4 class="text-white fw-bold mb-0">WaffiHub <span class="text-info">CMS</span></h4>
        </div>

        <nav class="flex-column">
          <div class="nav-group-title">Main</div>
          <%= link_to admin_root_path, class: "sidebar-link #{'active' if current_page?(admin_root_path)}" do %>
            <i class="bi bi-speedometer2"></i> Dashboard
          <% end %>

          <div class="nav-group-title">Core Operations</div>
          <%= link_to admin_programs_path, class: "sidebar-link #{'active' if controller_name == 'programs'}" do %>
            <i class="bi bi-mortarboard"></i> Programs
          <% end %>
          <%= link_to admin_enrollments_path, class: "sidebar-link #{'active' if controller_name == 'enrollments'}" do %>
            <i class="bi bi-people"></i> Enrollments
          <% end %>
          <%= link_to admin_services_path, class: "sidebar-link #{'active' if controller_name == 'services'}" do %>
            <i class="bi bi-cpu"></i> Services
          <% end %>
          <%= link_to admin_plans_path, class: "sidebar-link #{'active' if controller_name == 'plans'}" do %>
            <i class="bi bi-tags"></i> Pricing Plans
          <% end %>

          <div class="nav-group-title">Content HUB</div>
          <%= link_to admin_posts_path, class: "sidebar-link #{'active' if controller_name == 'posts'}" do %>
            <i class="bi bi-newspaper"></i> News & Insights
          <% end %>
          <%= link_to admin_projects_path, class: "sidebar-link #{'active' if controller_name == 'projects'}" do %>
            <i class="bi bi-kanban"></i> Projects
          <% end %>

          <div class="nav-group-title">Project Submissions</div>
          <%= link_to admin_project_applications_path, class: "sidebar-link #{'active' if controller_name == 'project_applications'}" do %>
            <i class="bi bi-person-plus"></i> Applications
          <% end %>
          <%= link_to admin_project_partnerships_path, class: "sidebar-link #{'active' if controller_name == 'project_partnerships'}" do %>
            <i class="bi bi-briefcase"></i> Project Partnerships
          <% end %>

          <div class="nav-group-title">Ecosystem</div>
          <%= link_to admin_team_members_path, class: "sidebar-link #{'active' if controller_name == 'team_members'}" do %>
            <i class="bi bi-person-badge"></i> The Team
          <% end %>
          <%= link_to admin_partners_path, class: "sidebar-link #{'active' if controller_name == 'partners'}" do %>
            <i class="bi bi-briefcase"></i> Strategic Partners
          <% end %>
          <%= link_to admin_inquiries_path, class: "sidebar-link #{'active' if controller_name == 'inquiries'}" do %>
            <i class="bi bi-chat-dots"></i> Community Inbox
          <% end %>

          <div class="nav-group-title">Communications</div>
          <%= link_to admin_emails_path, class: "sidebar-link #{'active' if controller_name == 'emails'}" do %>
            <i class="bi bi-envelope-paper"></i> Email Messages
          <% end %>
        </nav>

        <div class="sidebar-user">
          <div class="d-flex align-items-center mb-3">
            <div class="rounded-circle bg-info text-dark d-flex align-items-center justify-content-center fw-bold small me-2" style="width: 32px; height: 32px;">
              <%= current_user.email[0].upcase %>
            </div>
            <div class="overflow-hidden">
              <div class="text-white small fw-bold text-truncate"><%= current_user.email %></div>
              <div class="small text-white">System Administrator</div>
            </div>
          </div>
          <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "btn btn-outline-danger btn-sm w-100 rounded-pill small" %>
        </div>
      </aside>

      <%# MAIN CONTENT %>
      <main class="admin-content">
        <% if notice %>
          <div class="alert alert-success border-0 shadow-sm rounded-4 mb-4"><%= notice %></div>
        <% end %>
        <% if alert %>
          <div class="alert alert-danger border-0 shadow-sm rounded-4 mb-4"><%= alert %></div>
        <% end %>

        <%= yield %>
      </main>
    </div>

    <script>
      // Tooltip or Other Admin JS could go here
    </script>
  </body>
</html>
