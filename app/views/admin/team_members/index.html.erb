<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3">Team Members</h1>
  <%= link_to "Add Member", new_admin_team_member_path, class: "btn btn-primary" %>
</div>

<div class="row">
  <% @team_members.each do |member| %>
    <div class="col-md-4 mb-4">
      <div class="card h-100 shadow-sm border-0">
        <div class="card-body text-center">
          <% if member.image.attached? %>
            <%= image_tag member.image, class: "rounded-circle mb-3", style: "width: 100px; height: 100px; object-fit: cover;" %>
          <% else %>
            <div class="rounded-circle bg-secondary d-inline-block mb-3" style: "width: 100px; height: 100px;"></div>
          <% end %>
          <h5 class="card-title"><%= member.name %></h5>
          <p class="text-muted"><%= member.role %></p>
          <div class="mt-3">
            <%= link_to "Edit", edit_admin_team_member_path(member), class: "btn btn-outline-primary btn-sm" %>
            <%= button_to "Delete", admin_team_member_path(member), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-outline-danger btn-sm d-inline-block" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
