<%# 1. PROFESSIONAL HERO SECTION (KEPT AS REQUESTED) %>
<section class="position-relative py-9 py-lg-10 overflow-hidden bg-primary-custom text-white">
  <div class="position-absolute top-0 start-0 w-100 h-100 opacity-50">
    <%= image_tag "about_hero.png", class: "w-100 h-100", style: "object-fit: cover; filter: brightness(0.4);" %>
  </div>
  <div class="container position-relative z-1 py-9">
    <div class="row justify-content-center text-center">
      <div class="col-lg-8" data-aos="fade-up">
        <h6 class="text-white-50 fw-bold text-uppercase ls-wide mb-3" style="margin-top:50px;">What We Do</h6>
        <h1 class="display-3 fw-bold mb-4 text-white">Our <span class="text-info">Projects</span>.</h1>
        <p class="lead text-white-50" style="margin-bottom:50px;">A showcase of the transformative work we've done for our clients and community.</p>
      </div>
    </div>
  </div>
</section>

<section class="py-5 bg-light">
  <div class="container">
    <div class="row g-5">
      <% @projects.each do |project| %>
        <div class="col-lg-6">
          <div class="card border-0 shadow-sm overflow-hidden rounded-4 h-100 transition-hover">
            <div class="row g-0 h-100">
              <div class="col-md-5">
                <% if project.images.attached? %>
                  <%= image_tag project.images.first, class: "img-fluid h-100 w-100", style: "object-fit: cover; min-height: 250px;" %>
                <% else %>
                   <div class="bg-secondary h-100 w-100" style="min-height: 250px;"></div>
                <% end %>
              </div>
              <div class="col-md-7">
                <div class="card-body p-4 d-flex flex-column h-100">
                  <small class="text-primary-custom fw-bold text-uppercase ls-wide mb-2"><%= project.client %></small>
                  <h3 class="fw-bold mb-3"><%= project.name %></h3>
                  <div class="small text-muted mb-4">
                    <%= truncate(strip_tags(project.problem.to_s), length: 120) %>
                  </div>
                  <%= link_to "View Case Study", project_path(project), class: "mt-auto text-decoration-none fw-bold small" %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
