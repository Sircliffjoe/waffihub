<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 fw-bold text-dark mb-0">Pricing Plans</h1>
  <%= link_to new_admin_plan_path, class: "btn btn-primary rounded-pill px-4 shadow-sm fw-bold" do %>
    <i class="bi bi-plus-circle me-1"></i> New Plan
  <% end %>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0 border-0">
      <thead class="bg-light">
        <tr>
          <th class="py-3 px-4 text-muted fw-bold text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.05em;">Plan Name</th>
          <th class="py-3 px-4 text-muted fw-bold text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.05em;">Price</th>
          <th class="py-3 px-4 text-muted fw-bold text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.05em;">Status</th>
          <th class="py-3 px-4 text-muted fw-bold text-uppercase text-end" style="font-size: 0.8rem; letter-spacing: 0.05em;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @plans.each do |plan| %>
          <tr>
            <td class="px-4 py-3">
              <span class="fw-bold text-dark"><%= plan.name %></span>
            </td>
            <td class="px-4 py-3 text-muted fw-semibold">
              <%= number_to_currency(plan.price, unit: "₦") %><%= plan.interval %>
            </td>
            <td class="px-4 py-3">
              <% if plan.highlight %>
                <span class="badge bg-warning text-dark border rounded-pill px-3 py-2 fw-semibold">
                  Most Popular
                </span>
              <% else %>
                <span class="badge bg-light text-muted border rounded-pill px-3 py-2 fw-semibold">
                  Standard
                </span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-end">
              <div class="btn-group border rounded-pill overflow-hidden shadow-sm">
                <%= link_to edit_admin_plan_path(plan), class: "btn btn-light btn-sm text-primary-custom fw-bold border-0 px-3", title: "Edit" do %>
                  <i class="bi bi-pencil"></i> Edit
                <% end %>
                <%= button_to admin_plan_path(plan), method: :delete, data: { confirm: "Are you sure you want to delete this plan?" }, class: "btn btn-light btn-sm text-danger fw-bold border-0 px-3 border-start", title: "Delete" do %>
                  <i class="bi bi-trash"></i> Delete
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
