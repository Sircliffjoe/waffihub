          <div class="p-4 border rounded-4 bg-light bg-opacity-50 transition-hover h-100 d-flex gap-3">
             <div class="text-primary-custom fs-2"><i class="bi bi-<%= item[:icon] %>"></i></div>
             <div>
                <h5 class="fw-bold mb-2"><%= item[:title] %></h5>
                <p class="text-muted small mb-0"><%= item[:desc] %></p>
             </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# 6. EXISTING CMS CONTENT SECTIONS (Updated with AOS) %>
<section class="py-6 bg-light">
  <div class="container">
    <div class="d-flex justify-content-between align-items-end mb-5" data-aos="fade-up">
      <div>
        <h2 class="fw-bold mb-0">Our Dynamic Programs</h2>
        <p class="text-muted mb-0 font-monospace small">Catch them young. Empowering the future.</p>
      </div>
      <%= link_to "View All", programs_path, class: "btn btn-link text-decoration-none fw-bold" %>
    </div>

    <div class="row g-4">
      <% @featured_programs.each_with_index do |program, i| %>
        <div class="col-md-4" data-aos="fade-up" data-aos-delay="<%= i * 100 %>">
          <%#= render partial: 'programs/program_card', locals: { program: program } %>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# Partners Section %>
<section class="py-5 bg-light border-top">
  <div class="container">
    <div class="text-center mb-4">
      <p class="text-muted small fw-bold text-uppercase ls-wide">Our Partners</p>
    </div>
    <div class="d-flex flex-wrap justify-content-center align-items-center gap-5 opacity-75">
      <% @partners.each do |partner| %>
        <% if partner.logo.attached? %>
          <%= image_tag partner.logo, class: "img-fluid grayscale", style: "max-height: 40px; width: auto;", title: partner.name %>
        <% else %>
          <span class="fw-bold h5 text-muted"><%= partner.name %></span>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<script>
  document.addEventListener('turbo:load', () => {
    const ctx = document.getElementById('impactChart');
    if (ctx) {
      new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: ['Youth Trained', 'Jobs Created', 'Startups Supported', 'Female Businesses'],
          datasets: [{
            data: [50000, 12500, 450, 150],
            backgroundColor: [
              '#34495E',
              '#198754',
              '#FFC107',
              '#0DCAF0'
            ],
            borderWidth: 0,
            hoverOffset: 20
          }]
        },
        options: {
          plugins: {
            legend: { position: 'bottom', labels: { usePointStyle: true, padding: 20 } }
          },
          cutout: '70%',
          animation: { animateRotate: true, animateScale: true }
        }
      });
    }
  });
</script>
