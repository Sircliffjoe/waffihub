<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3">Project Applications</h1>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="bg-light">
        <tr>
          <th>Applicant</th>
          <th>Project</th>
          <th>Location</th>
          <th>Status</th>
          <th>Date</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @applications.each do |app| %>
          <tr>
            <td>
              <div class="fw-bold"><%= app.name %></div>
              <div class="small text-muted"><%= app.email %></div>
            </td>
            <td><span class="badge bg-info-subtle text-info rounded-pill px-3"><%= app.project.name %></span></td>
            <td><%= app.location %></td>
            <td>
              <span class="badge rounded-pill px-3 bg-<%= app.status == 'approved' ? 'success' : (app.status == 'rejected' ? 'danger' : 'warning') %>-subtle text-<%= app.status == 'approved' ? 'success' : (app.status == 'rejected' ? 'danger' : 'warning') %> text-capitalize">
                <%= app.status %>
              </span>
            </td>
            <td><%= app.created_at.strftime("%b %d, %Y") %></td>
            <td class="text-end">
              <%= link_to "Review", admin_project_application_path(app), class: "btn btn-outline-primary btn-sm rounded-pill px-3" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
