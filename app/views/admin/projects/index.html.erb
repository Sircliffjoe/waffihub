<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3">Our Projects</h1>
  <%= link_to "New Project", new_admin_project_path, class: "btn btn-primary" %>
</div>

<div class="row">
  <% @projects.each do |project| %>
    <div class="col-md-6 mb-4">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body">
          <h5 class="card-title"><%= project.name %></h5>
          <h6 class="card-subtitle mb-2 text-muted">Client: <%= project.client %></h6>
          <div class="mt-3">
            <%= link_to "View", admin_project_path(project), class: "btn btn-outline-info btn-sm" %>
            <%= link_to "Edit", edit_admin_project_path(project), class: "btn btn-outline-primary btn-sm" %>
            <%= button_to "Delete", admin_project_path(project), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-outline-danger btn-sm d-inline-block" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
