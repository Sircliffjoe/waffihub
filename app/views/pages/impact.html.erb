<%# 1. PROFESSIONAL HERO SECTION %>
<section class="position-relative py-9 py-lg-10 overflow-hidden bg-primary-custom text-white">
  <div class="position-absolute top-0 start-0 w-100 h-100 opacity-50">
    <%= image_tag "about_hero.png", class: "w-100 h-100", style: "object-fit: cover; filter: brightness(0.4);" %>
  </div>
  <div class="container position-relative z-1 py-9">
    <div class="row justify-content-center text-center">
      <div class="col-lg-8" data-aos="fade-up">
        <h6 class="text-white-50 fw-bold text-uppercase ls-wide mb-3" style="margin-top:50px;">Our Footprint</h6>
        <h1 class="display-3 fw-bold mb-4 text-white">Measured <span class="text-info">Impact</span>.</h1>
        <p class="lead text-white-50" style="margin-bottom:50px;">Tracking our journey in transforming the Niger Delta tech ecosystem.</p>
      </div>
    </div>
  </div>
</section>

<%# 2. IMPACT METRICS DASHBOARD %>
<section class="py-8 bg-white overflow-hidden">
  <div class="container">
    <div class="text-center mb-7" data-aos="fade-up">
      <h6 class="text-primary-custom fw-bold text-uppercase ls-wide mb-2">The Numbers</h6>
      <h2 class="display-5 fw-bold mb-3">Impact at a Glance</h2>
      <p class="lead text-muted mx-auto" style="max-width: 700px;">Cumulative growth and success metrics since our inception.</p>
    </div>

    <div class="row g-5">
      <% [
        { label: "Talents Trained", value: "5,000+", color: "primary-custom", icon: "people" },
        { label: "Startups Incubated", value: "85+", color: "success", icon: "rocket-takeoff" },
        { label: "Community Events", value: "120+", color: "info", icon: "calendar3" },
        { label: "Investment Raised", value: "₦2.5B+", color: "warning", icon: "graph-up-arrow" }
      ].each_with_index do |stat, i| %>
        <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="<%= i * 100 %>">
          <div class="p-5 bg-light rounded-5 border-bottom border-4 border-<%= stat[:color] %> shadow-sm transition-hover text-center h-100">
            <div class="icon-box-sm bg-white text-<%= stat[:color] %> mb-4 mx-auto shadow-sm rounded-4">
              <i class="bi bi-<%= stat[:icon] %>"></i>
            </div>
            <h2 class="display-5 fw-bold text-<%= stat[:color] %> mb-2"><%= stat[:value] %></h2>
            <p class="text-muted fw-bold small mb-0 text-uppercase ls-wide"><%= stat[:label] %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# 3. SUCCESS TRACKS / PROJECTS HIGHLIGHT %>
<section class="py-8 bg-light overflow-hidden" id="projects">
  <div class="container">
    <div class="row align-items-end mb-7" data-aos="fade-up">
      <div class="col-lg-7">
        <h6 class="text-primary-custom fw-bold text-uppercase ls-wide mb-2">Our Portfolio</h6>
        <h2 class="display-5 fw-bold mb-0">Flagship Projects</h2>
      </div>
      <div class="col-lg-5 text-lg-end">
        <p class="text-muted small fw-semibold mb-0">Delivering social & economic value through technology.</p>
      </div>
    </div>

    <div class="row g-5">
      <% @projects.each_with_index do |project, i| %>
        <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="<%= i * 100 %>">
          <div class="card h-100 border-0 shadow-lg rounded-5 overflow-hidden transition-hover">
            <div class="aspect-ratio-box bg-light" style="height: 250px; overflow: hidden;">
              <% if project.main_image.attached? %>
                <%= image_tag project.main_image, class: "card-img-top h-100 w-100", style: "object-fit: cover;" %>
              <% else %>
                <img src="https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&q=80&w=800" class="card-img-top h-100 w-100" style="object-fit: cover;" alt="Project">
              <% end %>
            </div>
            <div class="card-body p-5">
              <h5 class="fw-bold mb-2 h4"><%= project.name %></h5>
              <div class="d-flex align-items-center mb-3 text-muted extra-small text-uppercase fw-bold ls-wide">
                <i class="bi bi-building me-2"></i> Client: <%= project.client %>
              </div>
              <p class="text-muted small mb-0"><%= truncate(strip_tags(project.problem.to_s), length: 120) %></p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# 4. SUCCESS STORY SPOTLIGHT %>
<section class="py-8 bg-white overflow-hidden">
  <div class="container">
    <div class="row g-5 align-items-center">
      <div class="col-lg-6" data-aos="fade-right">
        <div class="rounded-5 overflow-hidden shadow-2xl position-relative p-2 bg-light">
          <img src="https://images.unsplash.com/photo-1553729459-efe14ef6055d?auto=format&fit=crop&q=80&w=1200" class="img-fluid rounded-4" alt="Success Story">
        </div>
      </div>
      <div class="col-lg-6" data-aos="fade-left">
        <div class="ps-lg-5">
          <h6 class="text-primary-custom fw-bold text-uppercase ls-wide mb-2">Success Spotlight</h6>
          <h2 class="display-5 fw-bold mb-4">From Desk to Global Marketplace</h2>
          <p class="lead text-muted mb-4">"WaffiHub provided the infrastructure and community I needed to scale my startup from a local idea to an international service provider. The mentorship was world-class."</p>
          <div class="d-flex align-items-center mb-5">
            <div class="rounded-circle overflow-hidden me-3" style="width: 60px; height: 60px;">
              <img src="https://images.unsplash.com/photo-1560298814-14f964a440b2?auto=format&fit=crop&q=80&w=200" class="w-100 h-100" style="object-fit: cover;" alt="Success Story Founder">
            </div>
            <div>
              <h6 class="fw-bold mb-0">Tega Akpojotor</h6>
              <p class="text-muted small mb-0">Founder, DeltaTech Solutions</p>
            </div>
          </div>
          <%= link_to "Read More Stories", root_path, class: "btn btn-outline-primary rounded-pill px-5 py-3 fw-bold" %>
        </div>
      </div>
    </div>
  </div>
</section>

<%# 5. PHILANTHROPY & PARTNERSHIP CTA %>
<section class="py-8 bg-primary-custom text-white text-center position-relative overflow-hidden">
  <div class="container position-relative z-1" data-aos="zoom-in">
    <h6 class="text-white-50 fw-bold text-uppercase ls-wide mb-3">Join the Movement</h6>
    <h2 class="display-4 fw-bold mb-4 text-white">Let's Create More Impact Together</h2>
    <p class="lead text-white-50 mb-5 mx-auto" style="max-width: 750px;">Partner with WaffiHub to support digital literacy, entrepreneurship, and innovation across the Niger Delta.</p>
    <div class="d-flex flex-wrap justify-content-center gap-3">
      <%= link_to "Partner with Us", contact_path, class: "btn btn-info btn-lg rounded-pill px-5 py-3 fw-bold" %>
      <%= link_to "Volunteer Mentorship", contact_path, class: "btn btn-outline-light btn-lg rounded-pill px-5 py-3 fw-bold" %>
    </div>
  </div>
</section>
