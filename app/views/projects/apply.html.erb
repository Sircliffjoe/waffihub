<section class="py-9 bg-primary-custom text-white text-center position-relative overflow-hidden">
  <div class="position-absolute top-0 start-0 w-100 h-100 opacity-25">
    <%= image_tag "about_hero.png", class: "w-100 h-100", style: "object-fit: cover;" %>
  </div>
  <div class="container position-relative z-1 py-5">
    <h6 class="text-info fw-bold text-uppercase ls-wide mb-3">Participation Application</h6>
    <h1 class="display-4 fw-bold mb-0 text-white">Apply for <%= @project.name %></h1>
  </div>
</section>

<section class="py-10 bg-light">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card border-0 shadow-2xl rounded-5 p-5 bg-white" data-aos="fade-up">
          <h3 class="fw-bold mb-4">Your Information</h3>
          <p class="text-muted mb-5">Please fill out the form below to apply for participation in this project. Our team will review your application and get back to you.</p>

          <% if @application.errors.any? %>
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
              <h4 class="alert-heading">Please fix the following errors:</h4>
              <ul class="mb-0">
                <% @application.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% end %>

          <%= form_with model: [@project, @application], url: apply_project_path(@project), class: "row g-4" do |f| %>
            <div class="col-md-6">
              <%= f.label :first_name, "First Name", class: "form-label text-muted fw-bold text-uppercase small ls-wide" %>
              <%= f.text_field :first_name, class: "form-control form-control-lg border-light shadow-sm rounded-pill px-4 bg-white", placeholder: "e.g., John", required: true %>
            </div>
            <div class="col-md-6">
              <%= f.label :last_name, "Last Name", class: "form-label text-muted fw-bold text-uppercase small ls-wide" %>
              <%= f.text_field :last_name, class: "form-control form-control-lg border-light shadow-sm rounded-pill px-4 bg-white", placeholder: "e.g., Doe", required: true %>
            </div>
            <div class="col-md-6">
              <%= f.label :email, "Email Address", class: "form-label text-muted fw-bold text-uppercase small ls-wide" %>
              <%= f.email_field :email, class: "form-control form-control-lg border-light shadow-sm rounded-pill px-4 bg-white", placeholder: "e.g., john@example.com", required: true %>
            </div>
            <div class="col-md-6">
              <%= f.label :phone, "Phone Number", class: "form-label text-muted fw-bold text-uppercase small ls-wide" %>
              <%= f.text_field :phone, class: "form-control form-control-lg border-light shadow-sm rounded-pill px-4 bg-white", placeholder: "e.g., +234...", required: true %>
            </div>
            <div class="col-md-6">
              <%= f.label :age_group, "Age Group", class: "form-label text-muted fw-bold text-uppercase small ls-wide" %>
              <%= f.select :age_group, 
                  [
                    ["Select your age group", ""],
                    ["15-20", "15-20"],
                    ["21-25", "21-25"],
                    ["26-30", "26-30"],
                    ["31-40", "31-40"],
                    ["41-50", "41-50"],
                    ["50+", "50+"]
                  ],
                  { required: true },
                  class: "form-control form-control-lg border-light shadow-sm rounded-pill px-4 bg-white" %>
            </div>
            <div class="col-md-6">
              <%= f.label :marital_status, "Marital Status", class: "form-label text-muted fw-bold text-uppercase small ls-wide" %>
              <%= f.select :marital_status, 
                  [
                    ["Select marital status", ""],
                    ["Single", "Single"],
                    ["Married", "Married"]
                  ],
                  { required: true },
                  class: "form-control form-control-lg border-light shadow-sm rounded-pill px-4 bg-white" %>
            </div>
            <div class="col-md-6">
              <%= f.label :course_track, "Course/Track", class: "form-label text-muted fw-bold text-uppercase small ls-wide" %>
              <%= f.select :course_track, 
                  (["Select a course/track", ""] + @project.tracks_list.map { |track| [track, track] }),
                  { required: true },
                  class: "form-control form-control-lg border-light shadow-sm rounded-pill px-4 bg-white" %>
            </div>
            <div class="col-12">
              <%= f.label :address, "Residential Address", class: "form-label text-muted fw-bold text-uppercase small ls-wide" %>
              <%= f.text_area :address, class: "form-control border-light shadow-sm rounded-4 px-4 pt-3 bg-white", rows: 3, placeholder: "Your full address...", required: true %>
            </div>
            <div class="col-12">
              <%= f.label :background, "Educational/Professional Background", class: "form-label text-muted fw-bold text-uppercase small ls-wide" %>
              <%= f.text_area :background, class: "form-control border-light shadow-sm rounded-5 px-4 pt-3 bg-white", rows: 4, placeholder: "Briefly tell us about your background...", required: true %>
            </div>
            <div class="col-12">
              <%= f.label :reason, "Why do you want to join this project?", class: "form-label text-muted fw-bold text-uppercase small ls-wide" %>
              <%= f.text_area :reason, class: "form-control border-light shadow-sm rounded-5 px-4 pt-3 bg-white", rows: 4, placeholder: "What motivates you to be part of this initiative?", required: true %>
            </div>
            <div class="col-12 mt-5 text-center">
              <%= f.submit "Submit Application", class: "btn btn-primary btn-lg rounded-pill px-5 py-3 fw-bold shadow-lg w-100 w-md-auto" %>
              <div class="mt-3">
                <%= link_to "Cancel and return to project", project_path(@project), class: "text-muted small text-decoration-none" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .shadow-2xl { filter: drop-shadow(0 25px 25px rgba(0,0,0,0.1)); }
  .ls-wide { letter-spacing: 0.1em; }
</style>
