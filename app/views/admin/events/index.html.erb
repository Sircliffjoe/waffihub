<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Upcoming Events</h1>
  <%= link_to new_admin_event_path, class: "btn btn-primary rounded-pill px-4" do %>
    <i class="bi bi-plus-lg me-2"></i> Add Event
  <% end %>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="bg-light">
        <tr>
          <th>Color</th>
          <th>Title</th>
          <th>Category</th>
          <th>Start Time</th>
          <th>Location</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @events.each do |event| %>
          <tr>
            <td>
              <div class="rounded-circle shadow-sm" style="width: 24px; height: 24px; background-color: <%= event.border_color.presence || '#ccc' %>;"></div>
            </td>
            <td class="fw-bold"><%= event.title %></td>
            <td><span class="badge bg-light text-dark border"><%= event.category %></span></td>
            <td class="text-muted small"><%= event.start_time&.strftime("%b %d, %Y - %I:%M %p") %></td>
            <td class="text-muted small"><%= event.location %></td>
            <td class="text-end">
              <div class="d-flex justify-content-end gap-2">
                <%= link_to edit_admin_event_path(event), class: "btn btn-outline-info btn-sm rounded-pill px-3" do %>
                  <i class="bi bi-pencil-square"></i> Edit
                <% end %>
                <%= button_to admin_event_path(event), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-outline-danger btn-sm rounded-pill px-3" do %>
                  <i class="bi bi-trash"></i> Delete
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @events.empty? %>
          <tr>
            <td colspan="6" class="text-center py-5 text-muted">
              No events found. Start by adding one!
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
