<%= form_with(model: [:admin, service], class: "row g-3") do |f| %>
  <% if service.errors.any? %>
    <div class="col-12">
      <div class="alert alert-danger">
        <h4><%= pluralize(service.errors.count, "error") %> prohibited this service from being saved:</h4>
        <ul>
          <% service.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="col-md-6">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-control" %>
  </div>

  <div class="col-md-3">
    <%= f.label :pricing, class: "form-label" %>
    <div class="input-group">
      <span class="input-group-text">₦</span>
      <%= f.number_field :pricing, step: 0.01, class: "form-control" %>
    </div>
  </div>

  <div class="col-md-3">
    <%= f.label :category, class: "form-label" %>
    <%= f.select :category, ["Co-working and Training", "Startups/SMEs Business Services", "Private and Public Sector Innovation"], { include_blank: "Select Category" }, class: "form-select" %>
  </div>

  <div class="col-12">
    <%= f.label :image, class: "form-label" %>
    <%= f.file_field :image, class: "form-control" %>
  </div>

  <div class="col-12">
    <%= f.label :description, class: "form-label" %>
    <%= f.rich_text_area :description, class: "form-control", style: "min-height: 200px;" %>
  </div>

  <div class="col-12 mt-4">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_services_path, class: "btn btn-outline-secondary ms-2" %>
  </div>
<% end %>
