<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3">Email Message</h1>
  <%= link_to "Back to Emails", admin_emails_path, class: "btn btn-secondary" %>
</div>

<div class="card shadow-sm border-0">
  <div class="card-header bg-light">
    <h5 class="mb-0"><%= @email.subject %></h5>
  </div>
  
  <div class="card-body">
    <div class="row mb-4">
      <div class="col-md-6">
        <div class="mb-3">
          <strong>To:</strong>
          <div class="text-muted">
            <%= @email.recipient_name %> &lt;<%= @email.recipient_email %>&gt;
          </div>
        </div>
        <div class="mb-3">
          <strong>Type:</strong>
          <div>
            <span class="badge bg-info text-dark">
              <%= @email.contact_type.capitalize %>
            </span>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="mb-3">
          <strong>Status:</strong>
          <div>
            <% if @email.sent? %>
              <span class="badge bg-success">Sent</span>
            <% elsif @email.pending? %>
              <span class="badge bg-warning">Pending</span>
            <% elsif @email.failed? %>
              <span class="badge bg-danger">Failed</span>
            <% end %>
          </div>
        </div>
        <div class="mb-3">
          <strong>Sent On:</strong>
          <div class="text-muted">
            <%= @email.created_at.strftime("%B %d, %Y at %H:%M %p") %>
          </div>
        </div>
      </div>
    </div>

    <div class="border-top pt-4">
      <h6 class="mb-3">Message Body:</h6>
      <div class="bg-light p-3 rounded" style="white-space: pre-wrap; word-break: break-word;">
        <%= @email.body %>
      </div>
    </div>
  </div>
</div>
