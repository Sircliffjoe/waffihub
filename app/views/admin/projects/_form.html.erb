<%= form_with(model: [:admin, project], class: "needs-validation", html: { novalidate: true }) do |f| %>
  <% if project.errors.any? %>
    <div class="alert alert-danger rounded-4 border-0 shadow-sm mb-4">
      <h5 class="fw-bold"><%= pluralize(project.errors.count, "error") %> prohibited this project from being saved:</h5>
      <ul class="mb-0">
        <% project.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# ============================================ %>
  <%# SECTION 1: HERO / HEADER                     %>
  <%# ============================================ %>
  <div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-header bg-primary-custom text-white rounded-top-4 py-3 px-4">
      <h5 class="mb-0 fw-bold"><i class="bi bi-image me-2"></i>1. Hero Section</h5>
      <small class="text-white-50">The banner area visitors see first</small>
    </div>
    <div class="card-body p-4">
      <div class="row g-4">
        <div class="col-md-12">
          <%= f.label :name, "Project Title *", class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <%= f.text_field :name, class: "form-control form-control-lg border-0 bg-light rounded-pill px-4 fw-bold", placeholder: "e.g. SheBuilds Niger Delta", required: true %>
        </div>

        <div class="col-md-12">
          <%= f.label :tagline, "Sub-title / Tagline", class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <%= f.text_field :tagline, class: "form-control border-0 bg-light rounded-pill px-4", placeholder: "e.g. EMPOWERING THE RIVERINE COMMUNITIES" %>
          <div class="form-text small opacity-50 ps-3">Appears above the title in uppercase cyan text</div>
        </div>

        <div class="col-md-12">
          <%= f.label :hero_description, "Summary / Description", class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <%= f.text_area :hero_description, class: "form-control border-0 bg-light rounded-4 px-4 py-3", rows: 3, placeholder: "A practical, community-based digital skills intensive designed exclusively for..." %>
        </div>

        <div class="col-md-12">
          <%= f.label :main_image, "Hero Background Image", class: "form-label fw-bold text-muted text-uppercase small ls-wide d-block" %>
          <div class="p-3 bg-light rounded-4 border-2 border-dashed text-center">
            <% if project.persisted? && project.main_image.attached? %>
              <div class="mb-3">
                <%= image_tag project.main_image, class: "img-fluid rounded-3 shadow-sm", style: "max-height: 150px;" %>
              </div>
            <% end %>
            <%= f.file_field :main_image, class: "form-control border-0 bg-white rounded-pill", accept: 'image/*' %>
            <div class="mt-2 extra-small text-muted">Wide landscape image recommended (1920×800+)</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# ============================================ %>
  <%# SECTION 2: DETAILS / QUICK STATS             %>
  <%# ============================================ %>
  <div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-header bg-white py-3 px-4 border-bottom">
      <h5 class="mb-0 fw-bold text-primary-custom"><i class="bi bi-grid me-2"></i>2. Project Details</h5>
      <small class="text-muted">Quick stats displayed as cards below the hero</small>
    </div>
    <div class="card-body p-4">
      <div class="row g-4">
        <div class="col-md-6">
          <%= f.label :duration, class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <%= f.text_field :duration, class: "form-control border-0 bg-light rounded-pill px-4", placeholder: "e.g. 8 Weeks" %>
        </div>
        <div class="col-md-6">
          <%= f.label :format, class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <%= f.text_field :format, class: "form-control border-0 bg-light rounded-pill px-4", placeholder: "e.g. Community-Based" %>
        </div>
        <div class="col-md-6">
          <%= f.label :reach, class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <%= f.text_field :reach, class: "form-control border-0 bg-light rounded-pill px-4", placeholder: "e.g. 8 Communities/Year" %>
        </div>
        <div class="col-md-6">
          <%= f.label :cost, class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <%= f.text_field :cost, class: "form-control border-0 bg-light rounded-pill px-4", placeholder: "e.g. Free to Participants" %>
        </div>
      </div>
    </div>
  </div>

  <%# ============================================ %>
  <%# SECTION 3: ABOUT THE PROJECT                 %>
  <%# ============================================ %>
  <div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-header bg-white py-3 px-4 border-bottom">
      <h5 class="mb-0 fw-bold text-primary-custom"><i class="bi bi-file-text me-2"></i>3. About the Project</h5>
      <small class="text-muted">The detailed description, images, and inspirational quote</small>
    </div>
    <div class="card-body p-4">
      <div class="row g-4">
        <div class="col-md-6">
          <%= f.label :client, "Beneficiary / Client", class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <%= f.text_field :client, class: "form-control border-0 bg-light rounded-pill px-4", placeholder: "e.g. World Bank, Niger Delta Commission (optional)" %>
        </div>

        <div class="col-md-12">
          <%= f.label :about_description, "About Description", class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <%= f.text_area :about_description, class: "form-control border-0 bg-light rounded-4 px-4 py-3", rows: 4, placeholder: "Closing the Digital Gap, One Community at a Time..." %>
        </div>

        <div class="col-12">
          <%= f.label :problem, "Project Details (Challenge / Context)", class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <div class="bg-light rounded-4 p-2">
            <%= f.rich_text_area :problem, class: "form-control border-0 bg-transparent", style: "min-height: 180px;" %>
          </div>
          <div class="form-text small opacity-50 ps-3">Use bullet points to list key details like training locations, tools used, etc.</div>
        </div>

        <div class="col-12">
          <%= f.label :solution, "Approach / Solution", class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <div class="bg-light rounded-4 p-2">
            <%= f.rich_text_area :solution, class: "form-control border-0 bg-transparent", style: "min-height: 180px;" %>
          </div>
        </div>

        <div class="col-12">
          <%= f.label :outcome, "Final Outcome / Impact", class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <div class="bg-light rounded-4 p-2">
            <%= f.rich_text_area :outcome, class: "form-control border-0 bg-transparent", style: "min-height: 180px;" %>
          </div>
        </div>

        <div class="col-md-12">
          <%= f.label :about_quote, "Inspirational Quote", class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <%= f.text_area :about_quote, class: "form-control border-0 bg-light rounded-4 px-4 py-3", rows: 2, placeholder: '"We are not bringing the digital world to your community. We are helping your community take its rightful place in it."' %>
        </div>

        <div class="col-md-12">
          <%= f.label :images, "Project Gallery", class: "form-label fw-bold text-muted text-uppercase small ls-wide d-block" %>
          <div class="p-3 bg-light rounded-4 border-2 border-dashed text-center">
            <% if project.persisted? && project.images.attached? %>
              <div class="d-flex flex-wrap gap-2 mb-3 justify-content-center">
                <% project.images.each do |image| %>
                  <%= image_tag image, class: "rounded border shadow-sm", style: "width: 60px; height: 60px; object-fit: cover;" %>
                <% end %>
              </div>
            <% end %>
            <%= f.file_field :images, multiple: true, class: "form-control border-0 bg-white rounded-pill", accept: 'image/*' %>
            <div class="mt-2 extra-small text-muted">Used in About section and Partner section. First image = About, Second = Partner.</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# ============================================ %>
  <%# SECTION 4: TRACKS (JSON BUILDER)             %>
  <%# ============================================ %>
  <div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-header bg-white py-3 px-4 border-bottom">
      <h5 class="mb-0 fw-bold text-primary-custom"><i class="bi bi-diagram-3 me-2"></i>4. Tracks / Modules</h5>
      <small class="text-muted">E.g. "Earning-Focused Tracks" — the learning paths or components</small>
    </div>
    <div class="card-body p-4">
      <div class="row g-4 mb-4">
        <div class="col-md-6">
          <%= f.label :curriculum_title, "Section Title", class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <%= f.text_field :curriculum_title, class: "form-control border-0 bg-light rounded-pill px-4", placeholder: "e.g. Earning-Focused Tracks" %>
        </div>
        <div class="col-md-12">
          <%= f.label :curriculum_description, "Section Description", class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <%= f.text_area :curriculum_description, class: "form-control border-0 bg-light rounded-4 px-4 py-3", rows: 2, placeholder: "Every track is designed around a single question..." %>
        </div>
      </div>

      <%= f.hidden_field :tracks, value: (project.tracks.present? ? project.tracks.to_json : "[]"), id: "tracks_json" %>

      <div id="tracks-container" class="mb-3"></div>

      <button type="button" class="btn btn-outline-primary rounded-pill px-4" onclick="addTrack()">
        <i class="bi bi-plus-circle me-1"></i> Add Track
      </button>
    </div>
  </div>

  <%# ============================================ %>
  <%# SECTION 5: TIMELINE (JSON BUILDER)           %>
  <%# ============================================ %>
  <div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-header bg-white py-3 px-4 border-bottom">
      <h5 class="mb-0 fw-bold text-primary-custom"><i class="bi bi-clock-history me-2"></i>5. Timeline / Journey</h5>
      <small class="text-muted">E.g. "Community-First Journey" — the phases of the project</small>
    </div>
    <div class="card-body p-4">
      <div class="row g-4 mb-4">
        <div class="col-md-6">
          <%= f.label :timeline_title, "Section Title", class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <%= f.text_field :timeline_title, class: "form-control border-0 bg-light rounded-pill px-4", placeholder: "e.g. Community-First Journey" %>
        </div>
        <div class="col-md-12">
          <%= f.label :timeline_description, "Section Description", class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <%= f.text_area :timeline_description, class: "form-control border-0 bg-light rounded-4 px-4 py-3", rows: 2, placeholder: "We do nothing without your blessing and your partnership. Here is our process." %>
        </div>
      </div>

      <%= f.hidden_field :timeline_steps, value: (project.timeline_steps.present? ? project.timeline_steps.to_json : "[]"), id: "timeline_json" %>

      <div id="timeline-container" class="mb-3"></div>

      <button type="button" class="btn btn-outline-primary rounded-pill px-4" onclick="addTimeline()">
        <i class="bi bi-plus-circle me-1"></i> Add Timeline Step
      </button>
    </div>
  </div>

  <%# ============================================ %>
  <%# SECTION 6: PARTNERSHIP                       %>
  <%# ============================================ %>
  <div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-header bg-white py-3 px-4 border-bottom">
      <h5 class="mb-0 fw-bold text-primary-custom"><i class="bi bi-handshake me-2"></i>6. Partner for Impact</h5>
      <small class="text-muted">The partnership call-to-action section</small>
    </div>
    <div class="card-body p-4">
      <div class="row g-4 mb-4">
        <div class="col-md-12">
          <%= f.label :partnership_title, "Section Title", class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <%= f.text_field :partnership_title, class: "form-control border-0 bg-light rounded-pill px-4", placeholder: "e.g. Partner for Impact" %>
        </div>
        <div class="col-md-12">
          <%= f.label :partnership_description, "Section Description", class: "form-label fw-bold text-muted text-uppercase small ls-wide" %>
          <%= f.text_area :partnership_description, class: "form-control border-0 bg-light rounded-4 px-4 py-3", rows: 3, placeholder: "We are looking for partner communities to host SheBuilds cohorts of 40-60 women..." %>
        </div>
      </div>

      <%= f.hidden_field :partnership_bullets, value: (project.partnership_bullets.present? ? project.partnership_bullets.to_json : "[]"), id: "bullets_json" %>

      <label class="form-label fw-bold text-muted text-uppercase small ls-wide">Impact Bullet Points</label>
      <div id="bullets-container" class="mb-3"></div>

      <button type="button" class="btn btn-outline-primary rounded-pill px-4" onclick="addBullet()">
        <i class="bi bi-plus-circle me-1"></i> Add Bullet Point
      </button>
    </div>
  </div>

  <%# ============================================ %>
  <%# SUBMIT BUTTONS                               %>
  <%# ============================================ %>
  <div class="d-flex gap-3 mb-5">
    <%= f.submit class: "btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-lg" %>
    <%= link_to "Cancel", admin_projects_path, class: "btn btn-outline-secondary btn-lg rounded-pill px-5" %>
  </div>
<% end %>

<style>
  .border-dashed { border-style: dashed !important; }
  .ls-wide { letter-spacing: 0.1em; }
  .extra-small { font-size: 0.7rem; }
  trix-editor { border: none !important; background: transparent !important; }
  trix-toolbar .trix-button-group { border-color: rgba(0,0,0,0.05) !important; margin-bottom: 10px !important; }
  .json-entry { background: #f8f9fa; border-radius: 1rem; padding: 1rem; margin-bottom: 0.75rem; position: relative; }
  .json-entry .btn-remove { position: absolute; top: 0.5rem; right: 0.5rem; }
</style>

<script>
  // =============================================
  // TRACKS JSON BUILDER
  // =============================================
  let tracksData = [];
  try { tracksData = JSON.parse(document.getElementById('tracks_json').value) || []; } catch(e) { tracksData = []; }

  function renderTracks() {
    const container = document.getElementById('tracks-container');
    container.innerHTML = '';
    tracksData.forEach((track, i) => {
      container.innerHTML += `
        <div class="json-entry">
          <button type="button" class="btn btn-sm btn-outline-danger rounded-pill btn-remove" onclick="removeTrack(${i})"><i class="bi bi-x"></i></button>
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label small fw-bold text-muted">Icon (Bootstrap Icons)</label>
              <input type="text" class="form-control border-0 bg-white rounded-pill px-3" value="${track.icon || ''}" onchange="updateTrack(${i}, 'icon', this.value)" placeholder="e.g. cpu, phone, share">
            </div>
            <div class="col-md-8">
              <label class="form-label small fw-bold text-muted">Track Title</label>
              <input type="text" class="form-control border-0 bg-white rounded-pill px-3" value="${track.title || ''}" onchange="updateTrack(${i}, 'title', this.value)" placeholder="e.g. AI-Powered Income">
            </div>
            <div class="col-md-12">
              <label class="form-label small fw-bold text-muted">Description</label>
              <textarea class="form-control border-0 bg-white rounded-4 px-3" rows="2" onchange="updateTrack(${i}, 'desc', this.value)" placeholder="What participants will learn...">${track.desc || ''}</textarea>
            </div>
          </div>
        </div>
      `;
    });
    document.getElementById('tracks_json').value = JSON.stringify(tracksData);
  }

  function addTrack() { tracksData.push({ icon: '', title: '', desc: '' }); renderTracks(); }
  function removeTrack(i) { tracksData.splice(i, 1); renderTracks(); }
  function updateTrack(i, key, val) { tracksData[i][key] = val; document.getElementById('tracks_json').value = JSON.stringify(tracksData); }

  renderTracks();

  // =============================================
  // TIMELINE JSON BUILDER
  // =============================================
  let timelineData = [];
  try { timelineData = JSON.parse(document.getElementById('timeline_json').value) || []; } catch(e) { timelineData = []; }

  function renderTimeline() {
    const container = document.getElementById('timeline-container');
    container.innerHTML = '';
    timelineData.forEach((step, i) => {
      container.innerHTML += `
        <div class="json-entry">
          <button type="button" class="btn btn-sm btn-outline-danger rounded-pill btn-remove" onclick="removeTimeline(${i})"><i class="bi bi-x"></i></button>
          <div class="row g-3">
            <div class="col-md-3">
              <label class="form-label small fw-bold text-muted">Date / Label</label>
              <input type="text" class="form-control border-0 bg-white rounded-pill px-3" value="${step.label || ''}" onchange="updateTimeline(${i}, 'label', this.value)" placeholder="e.g. Weeks 1-5">
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-bold text-muted">Phase Name</label>
              <input type="text" class="form-control border-0 bg-white rounded-pill px-3" value="${step.phase || ''}" onchange="updateTimeline(${i}, 'phase', this.value)" placeholder="e.g. Foundations">
            </div>
            <div class="col-md-5">
              <label class="form-label small fw-bold text-muted">Details</label>
              <textarea class="form-control border-0 bg-white rounded-4 px-3" rows="2" onchange="updateTimeline(${i}, 'desc', this.value)" placeholder="Description of this phase...">${step.desc || ''}</textarea>
            </div>
          </div>
        </div>
      `;
    });
    document.getElementById('timeline_json').value = JSON.stringify(timelineData);
  }

  function addTimeline() { timelineData.push({ label: '', phase: '', desc: '' }); renderTimeline(); }
  function removeTimeline(i) { timelineData.splice(i, 1); renderTimeline(); }
  function updateTimeline(i, key, val) { timelineData[i][key] = val; document.getElementById('timeline_json').value = JSON.stringify(timelineData); }

  renderTimeline();

  // =============================================
  // PARTNERSHIP BULLETS BUILDER
  // =============================================
  let bulletsData = [];
  try { bulletsData = JSON.parse(document.getElementById('bullets_json').value) || []; } catch(e) { bulletsData = []; }

  function renderBullets() {
    const container = document.getElementById('bullets-container');
    container.innerHTML = '';
    bulletsData.forEach((bullet, i) => {
      container.innerHTML += `
        <div class="json-entry d-flex align-items-center gap-3">
          <i class="bi bi-star-fill text-info"></i>
          <input type="text" class="form-control border-0 bg-white rounded-pill px-3 flex-fill" value="${bullet}" onchange="updateBullet(${i}, this.value)" placeholder="e.g. Recognised & Branded Certificates of Completion">
          <button type="button" class="btn btn-sm btn-outline-danger rounded-pill" onclick="removeBullet(${i})"><i class="bi bi-x"></i></button>
        </div>
      `;
    });
    document.getElementById('bullets_json').value = JSON.stringify(bulletsData);
  }

  function addBullet() { bulletsData.push(''); renderBullets(); }
  function removeBullet(i) { bulletsData.splice(i, 1); renderBullets(); }
  function updateBullet(i, val) { bulletsData[i] = val; document.getElementById('bullets_json').value = JSON.stringify(bulletsData); }

  renderBullets();
</script>
