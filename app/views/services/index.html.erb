<%# 1. PROFESSIONAL HERO SECTION (KEPT AS REQUESTED) %>
<section class="position-relative py-9 py-lg-10 overflow-hidden bg-primary-custom text-white">
  <div class="position-absolute top-0 start-0 w-100 h-100 opacity-50">
    <%= image_tag "about_hero.png", class: "w-100 h-100", style: "object-fit: cover; filter: brightness(0.4);" %>
  </div>
  <div class="container position-relative z-1 py-9">
    <div class="row justify-content-center text-center">
      <div class="col-lg-8" data-aos="fade-up">
        <h6 class="text-white-50 fw-bold text-uppercase ls-wide mb-3" style="margin-top:50px;">What We Do</h6>
        <h1 class="display-3 fw-bold mb-4 text-white">Specialized <span class="text-info">Services</span>.</h1>
        <p class="lead text-white-50" style="margin-bottom:50px;">Enterprise-grade solutions tailored for the Nigerian ecosystem.</p>
      </div>
    </div>
  </div>
</section>

<%# 2. STRATEGIC SERVICE GRID %>
<section class="py-8 bg-white">
  <div class="container">
    <div class="text-center mb-7" data-aos="fade-up">
      <h6 class="text-primary-custom fw-bold text-uppercase ls-wide mb-2">Capabilities</h6>
      <h2 class="display-5 fw-bold mb-3">Enterprise & Startup Solutions</h2>
      <p class="lead text-muted mx-auto" style="max-width: 700px;">Leveraging deep domain expertise to deliver robust digital transformation strategies.</p>
    </div>

    <div class="row g-5">
      <% @services.each_with_index do |service, i| %>
        <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="<%= i * 100 %>">
          <div class="card h-100 border-0 shadow-lg rounded-5 overflow-hidden transition-hover">
            <div class="p-5 bg-white d-flex flex-column h-100">
              <div class="icon-box-sm bg-primary-custom bg-opacity-10 text-primary-custom mb-4 rounded-4">
                <% 
                  icon = case service.title
                         when /Software/i then 'code-slash'
                         when /Consulting/i then 'clipboard-data'
                         when /Digital/i then 'cpu'
                         else 'briefcase'
                         end
                %>
                <i class="bi bi-<%= icon %>"></i>
              </div>
              <h4 class="fw-bold mb-3"><%= service.title %></h4>
              <span class="badge bg-light text-primary-custom mb-4 px-3 py-2 border align-self-start rounded-pill">
                <%= service.category %>
              </span>
              <p class="text-muted small mb-5"><%= truncate(strip_tags(service.description.to_s), length: 180) %></p>
              <div class="mt-auto pt-4 border-top">
                <%= link_to "Service Details →", service_path(service), class: "text-primary-custom text-decoration-none fw-bold small transition-all" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# 3. OUR METHODOLOGY SECTION %>
<section class="py-8 bg-light overflow-hidden">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-5" data-aos="fade-right">
        <h6 class="text-primary-custom fw-bold text-uppercase ls-wide mb-2">Our Workflow</h6>
        <h2 class="display-5 fw-bold mb-4">How We Deliver Excellence</h2>
        <p class="lead text-muted mb-5">We follow a structured, results-oriented methodology to ensure every engagement delivers measurable value.</p>
        
        <div class="d-grid gap-4">
          <% [
            { step: "01", title: "Discovery & Analysis", desc: "Understanding your business goals and current pain points." },
            { step: "02", title: "Strategic Planning", desc: "Designing a custom roadmap tailored to your specific needs." },
            { step: "03", title: "Agile Execution", desc: "Developing and deploying solutions with rapid iterations." },
            { step: "04", title: "Support & Optimization", desc: "Ensuring long-term success through continuous updates." }
          ].each do |item| %>
            <div class="d-flex gap-4">
              <div class="h4 fw-bold text-primary-custom opacity-25"><%= item[:step] %></div>
              <div>
                <h5 class="fw-bold mb-1"><%= item[:title] %></h5>
                <p class="text-muted small mb-0"><%= item[:desc] %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
      <div class="col-lg-7" data-aos="fade-left">
        <div class="rounded-5 overflow-hidden shadow-2xl p-2 bg-white">
          <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&q=80&w=1200" class="img-fluid rounded-4" alt="Collaborative Session">
        </div>
      </div>
    </div>
  </div>
</section>

<%# 4. BENEFITS SECTION %>
<section class="py-8 bg-white overflow-hidden">
  <div class="container">
    <div class="text-center mb-7" data-aos="fade-up">
      <h2 class="display-5 fw-bold mb-3">Why Partner With Us?</h2>
      <p class="lead text-muted mx-auto" style="max-width: 700px;">We combine local ecosystem insights with global technology standards.</p>
    </div>

    <div class="row g-5">
      <% [
        { icon: "award", title: "Expert Domain Knowledge", desc: "Specialists in software engineering, UI/UX, and data analytics." },
        { icon: "graph-up-arrow", title: "Scalable Results", desc: "Our solutions are built to grow alongside your business complexity." },
        { icon: "headset", title: "Dedicated Local Support", desc: "Proactive maintenance and support from a team physically present." },
        { icon: "shield-check", title: "Compliance & Security", desc: "Adhering to best practices in data protection and infrastructure." }
      ].each_with_index do |benefit, i| %>
        <div class="col-md-6" data-aos="fade-up" data-aos-delay="<%= i * 100 %>">
          <div class="p-5 bg-light rounded-5 h-100 transition-hover border-bottom border-4 border-transparent hover-border-primary">
            <div class="icon-box-sm bg-white text-primary-custom mb-4 rounded-4 shadow-sm">
              <i class="bi bi-<%= benefit[:icon] %>"></i>
            </div>
            <h4 class="fw-bold mb-3"><%= benefit[:title] %></h4>
            <p class="text-muted mb-0"><%= benefit[:benefit_desc] || benefit[:desc] %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# 5. FINAL CONSULTATION CTA %>
<section class="py-8 bg-primary-custom text-white text-center position-relative overflow-hidden">
  <div class="container position-relative z-1" data-aos="zoom-in">
    <h6 class="text-white-50 fw-bold text-uppercase ls-wide mb-3">Need a Custom Solution?</h6>
    <h2 class="display-4 fw-bold mb-4 text-white">Let's Build the Future Together</h2>
    <p class="lead text-white-50 mb-5 mx-auto" style="max-width: 750px;">Whether you are a startup looking to launch or an enterprise scaling operations, our team is ready to deliver.</p>
    <div class="d-flex flex-wrap justify-content-center gap-3">
      <%= link_to "Request a Consultation", contact_path, class: "btn btn-info btn-lg rounded-pill px-5 py-3 fw-bold" %>
      <%= link_to "Explore our Projects", projects_path, class: "btn btn-outline-light btn-lg rounded-pill px-5 py-3 fw-bold" %>
    </div>
  </div>
</section>
