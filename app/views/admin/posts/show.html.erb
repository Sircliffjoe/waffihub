<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "Posts", admin_posts_path %></li>
    <li class="breadcrumb-item active"><%= @post.title %></li>
  </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
  <h1 class="h3"><%= @post.title %></h1>
  <div>
    <%= link_to "Edit", edit_admin_post_path(@post), class: "btn btn-primary" %>
    <%= link_to "Back", admin_posts_path, class: "btn btn-outline-secondary ms-2" %>
  </div>
</div>

<div class="row">
  <div class="col-md-9">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body">
        <div class="mb-3">
          <span class="text-muted">Published: <%= @post.published_at&.strftime("%B %d, %Y at %I:%M %p") %></span>
          <br>
          <span class="text-muted">Slug: <code><%= @post.slug %></code></span>
        </div>
        <hr>
        <div class="rich-text-content mt-4">
          <%= @post.content %>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <% if @post.featured_image.attached? %>
      <div class="card shadow-sm border-0">
        <div class="card-body">
          <h5 class="card-title text-muted mb-3">Featured Image</h5>
          <%= image_tag @post.featured_image, class: "img-fluid rounded" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
