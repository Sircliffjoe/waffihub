<%# 1. PROFESSIONAL HERO SECTION (KEPT AS REQUESTED) %>
<section class="position-relative py-9 py-lg-10 overflow-hidden bg-primary-custom text-white">
  <div class="position-absolute top-0 start-0 w-100 h-100 opacity-50">
    <%= image_tag "about_hero.png", class: "w-100 h-100", style: "object-fit: cover; filter: brightness(0.4);" %>
  </div>
  <div class="container position-relative z-1 py-9">
    <div class="row justify-content-center text-center">
      <div class="col-lg-8" data-aos="fade-up">
        <h6 class="text-white-50 fw-bold text-uppercase ls-wide mb-3" style="margin-top:50px;">What We Do</h6>
        <h1 class="display-3 fw-bold mb-4 text-white">News & <span class="text-info">Updates</span>.</h1>
        <p class="lead text-white-50" style="margin-bottom:50px;">Empowering the next generation of digital talent through timely insights.</p>
      </div>
    </div>
  </div>
</section>

<%# 2. FEATURED POST SPOTLIGHT %>
<% if @posts.any? %>
  <% featured_post = @posts.first %>
  <section class="py-8 bg-white overflow-hidden">
    <div class="container">
      <div class="row g-5 align-items-center">
        <div class="col-lg-7" data-aos="fade-right">
          <div class="rounded-5 overflow-hidden shadow-2xl position-relative group p-2 bg-light">
            <% if featured_post.featured_image.attached? %>
              <%= image_tag featured_post.featured_image, class: "img-fluid rounded-4 transition-all group-hover-scale", style: "height: 450px; width: 100%; object-fit: cover;" %>
            <% else %>
               <img src="https://images.unsplash.com/photo-1504711434969-e33886168f5c?auto=format&fit=crop&q=80&w=1200" class="img-fluid rounded-4" style="height: 450px; width: 100%; object-fit: cover;" alt="Featured News">
            <% end %>
            <div class="position-absolute top-4 left-4">
              <span class="badge bg-info text-dark px-3 py-2 rounded-pill fw-bold shadow-sm">Featured Update</span>
            </div>
          </div>
        </div>
        <div class="col-lg-5" data-aos="fade-left">
          <div class="ps-lg-4">
            <div class="d-flex align-items-center mb-3">
              <span class="text-primary-custom fw-bold small text-uppercase ls-wide"><%= featured_post.published_at.strftime("%B %d, %Y") %></span>
              <span class="mx-2 text-muted opacity-50">/</span>
              <span class="text-muted small">5 min read</span>
            </div>
            <h2 class="display-5 fw-bold mb-4"><%= link_to featured_post.title, post_path(featured_post.slug), class: "text-dark text-decoration-none hover-primary" %></h2>
            <p class="lead text-muted mb-5"><%= truncate(strip_tags(featured_post.content.to_s), length: 220) %></p>
            <%= link_to "Read Full Article", post_path(featured_post.slug), class: "btn btn-primary rounded-pill px-5 py-3 fw-bold shadow-sm" %>
          </div>
        </div>
      </div>
    </div>
  </section>
<% end %>

<%# 3. NEWS ARCHIVE GRID %>
<section class="py-8 bg-light overflow-hidden">
  <div class="container">
    <div class="row align-items-end" style="margin-bottom: 40px;" data-aos="fade-up">
      <div class="col-lg-7">
        <h6 class="text-primary-custom fw-bold text-uppercase ls-wide mb-2">The Archive</h6>
        <h2 class="display-5 fw-bold mb-0">Recent Announcements</h2>
        <p class="text-muted small fw-semibold mb-0">Stay informed with the latest hub activities.</p>
      </div>
    </div>

    <div class="row g-5">
      <% @posts.offset(1).each_with_index do |post, i| %>
        <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="<%= i * 100 %>">
          <article class="h-100 transition-hover rounded-5 p-2 card border-0">
            <div class="mb-4 overflow-hidden rounded-5 shadow-sm" style="height: 260px;">
              <% if post.featured_image.attached? %>
                <%= link_to post_path(post.slug) do %>
                  <%= image_tag post.featured_image, class: "img-fluid h-100 w-100 transition-all", style: "object-fit: cover;" %>
                <% end %>
              <% else %>
                <%= link_to post_path(post.slug), class: "d-block h-100" do %>
                  <img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&q=80&w=800" class="img-fluid h-100 w-100" style="object-fit: cover;" alt="News">
                <% end %>
              <% end %>
            </div>
            <div class="px-3 pb-3">
              <time class="text-muted small fw-bold d-block mb-2 text-uppercase ls-wide"><%= post.published_at.strftime("%B %d, %Y") %></time>
              <h4 class="fw-bold mb-3"><%= link_to post.title, post_path(post.slug), class: "text-dark text-decoration-none hover-primary" %></h4>
              <p class="text-muted small mb-4"><%= truncate(strip_tags(post.content.to_s), length: 130) %></p>
              <%= link_to "Read Article →", post_path(post.slug), class: "link-primary text-decoration-none fw-bold small transition-all" %>
            </div>
          </article>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# 4. NEWSLETTER CTA %>
<section class="py-8 bg-primary-custom text-white position-relative overflow-hidden">
  <div class="container position-relative z-1" data-aos="zoom-in">
    <div class="row justify-content-center">
      <div class="col-lg-8 text-center">
        <h6 class="text-white-50 fw-bold text-uppercase ls-wide mb-3">Newsletter</h6>
        <h2 class="display-4 fw-bold mb-4 text-white">Never Miss a Hub Update</h2>
        <p class="lead text-white-50 mb-5">Subscribe to our weekly newsletter to get the latest tech news, event announcements, and ecosystem insights delivered straight to your inbox.</p>
        
        <form class="row g-3 justify-content-center">
          <div class="col-md-7">
            <input type="email" class="form-control form-control-lg rounded-pill border-0 px-4 bg-white bg-opacity-10 text-white placeholder-light shadow-none" placeholder="Enter your email address">
          </div>
          <div class="col-md-auto">
            <button type="button" class="btn btn-info btn-lg rounded-pill px-5 py-2 fw-bold w-100">Subscribe Now</button>
          </div>
        </form>
        <p class="extra-small text-white-50 mt-4">* We respect your privacy. No spam, just pure tech value.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .placeholder-light::placeholder { color: rgba(255,255,255,0.5); }
  .group:hover .group-hover-scale { transform: scale(1.05); }
  .transition-all { transition: all 0.5s ease; }
  .hover-primary:hover { color: var(--bs-info) !important; }
</style>
