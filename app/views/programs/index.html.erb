<%# 1. PROFESSIONAL HERO SECTION (KEPT AS REQUESTED) %>
<section class="position-relative py-9 py-lg-10 overflow-hidden bg-primary-custom text-white">
  <div class="position-absolute top-0 start-0 w-100 h-100 opacity-50">
    <%= image_tag "about_hero.png", class: "w-100 h-100", style: "object-fit: cover; filter: brightness(0.4);" %>
  </div>
  <div class="container position-relative z-1 py-9">
    <div class="row justify-content-center text-center">
      <div class="col-lg-8" data-aos="fade-up">
        <h6 class="text-white-50 fw-bold text-uppercase ls-wide mb-3" style="margin-top:50px;">What We Do</h6>
        <h1 class="display-3 fw-bold mb-4 text-white">Our <span class="text-info">Programs</span>.</h1>
        <p class="lead text-white-50" style="margin-bottom:50px;">Empowering the next generation of digital talent.</p>
      </div>
    </div>
  </div>
</section>

<%# 2. FEATURED PROGRAMS GRID %>
<section class="py-8 bg-white">
  <div class="container">
    <div class="text-center mb-7" data-aos="fade-up">
      <h6 class="text-primary-custom fw-bold text-uppercase ls-wide mb-2">Academics</h6>
      <h2 class="display-5 fw-bold mb-3">Accelerate Your Career</h2>
      <p class="lead text-muted mx-auto" style="max-width: 700px;">Project-based learning designed to take you from beginner to job-ready professional.</p>
    </div>

    <div class="row g-5">
      <% @programs.each_with_index do |program, i| %>
        <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="<%= i * 100 %>">
          <div class="card h-100 border-0 shadow-lg rounded-5 overflow-hidden transition-hover">
            <div class="aspect-ratio-box bg-light" style="height: 240px; overflow: hidden;">
              <% if program.main_image.attached? %>
                <%= image_tag program.main_image, class: "card-img-top h-100 w-100", style: "object-fit: cover;" %>
              <% else %>
                <% 
                  img_map = {
                    'Software' => 'software_bootcamp.png',
                    'Data' => 'data_science.png',
                    'UI/UX' => 'ui_ux_design.png'
                  }
                  matched_img = img_map.find { |k, v| program.title.include?(k) }&.last || 'software_bootcamp.png'
                %>
                <%= image_tag matched_img, class: "card-img-top h-100 w-100", style: "object-fit: cover;" %>
              <% end %>
            </div>
            
            <div class="card-body p-5 d-flex flex-column">
              <div class="d-flex justify-content-between align-items-center mb-4">
                <span class="badge bg-primary-custom bg-opacity-10 text-primary-custom px-3 py-2 rounded-pill small fw-bold">
                  <%= program.mode %>
                </span>
                <span class="text-muted small fw-bold text-uppercase ls-sm">
                  <i class="bi bi-clock me-1"></i> <%= program.duration %>
                </span>
              </div>
              
              <h3 class="fw-bold mb-3 h4"><%= program.title %></h3>
              <p class="text-muted small mb-5 flex-grow-1"><%= truncate(strip_tags(program.description.to_s), length: 140) %></p>
              
              <div class="mt-auto pt-4 border-top d-flex justify-content-between align-items-center">
                <div>
                   <div class="text-muted extra-small text-uppercase fw-bold ls-wide opacity-50">Tuition Fee</div>
                   <div class="h4 fw-bold mb-0 text-primary-custom"><%= number_to_currency(program.price, unit: "₦") %></div>
                </div>
                <%= link_to "View Details", program_path(program), class: "btn btn-primary rounded-pill px-4 shadow-sm" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# 3. LEARNING EXPERIENCE SECTION %>
<section class="py-8 bg-light overflow-hidden">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-6 order-lg-2" data-aos="fade-left">
        <h6 class="text-primary-custom fw-bold text-uppercase ls-wide mb-2">Our Method</h6>
        <h2 class="display-5 fw-bold mb-4">World-Class Learning Experience</h2>
        <p class="lead text-muted mb-5">At WaffiHub, we don't just teach modules; we build mindsets. Our curriculum is developed in tandem with industry leaders.</p>
        
        <div class="row g-4">
          <% [
            { icon: "layers", title: "Project-Based", desc: "Build real-world products as part of your training." },
            { icon: "people", title: "Mentorship", desc: "Regular 1-on-1 sessions with senior industry experts." },
            { icon: "briefcase", title: "Career Support", desc: "Resume building, mock interviews, and job placement aid." },
            { icon: "patch-check", title: "Certification", desc: "Globally recognized certificates upon successful completion." }
          ].each do |item| %>
            <div class="col-sm-6">
              <div class="mb-3 text-primary-custom h3">
                <i class="bi bi-<%= item[:icon] %>"></i>
              </div>
              <h5 class="fw-bold mb-2"><%= item[:title] %></h5>
              <p class="small text-muted mb-0"><%= item[:desc] %></p>
            </div>
          <% end %>
        </div>
      </div>
      <div class="col-lg-6 order-lg-1" data-aos="fade-right">
        <div class="rounded-5 overflow-hidden shadow-2xl p-2 bg-white">
          <img src="https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&q=80&w=1200" class="img-fluid rounded-4" alt="Students Core Learning">
        </div>
      </div>
    </div>
  </div>
</section>

<%# 4. FREQUENTLY ASKED QUESTIONS %>
<section class="py-8 bg-white overflow-hidden">
  <div class="container">
    <div class="text-center mb-7" data-aos="fade-up">
      <h2 class="display-5 fw-bold">Common Questions</h2>
    </div>
    
    <div class="row justify-content-center">
      <div class="col-lg-8" data-aos="fade-up">
        <div class="accordion accordion-flush" id="programsAccordion">
          <% [
            { q: "Is prior coding experience required?", a: "No, our bootcamps are designed to take absolute beginners to professional levels. We provide a pre-course prep kit to help you get started." },
            { q: "What is the difference between Hybrid and Online?", a: "Hybrid involves 2 days of physical hub-based collaboration and 3 days of remote live sessions. Online is 100% remote via Zoom and Slack." },
            { q: "Are there installation payment options?", a: "Yes, we allow a 60/40 payment split. 60% is paid before commencement and 40% is paid halfway through the program." },
            { q: "Will I get a job after the program?", a: "While we don't guarantee employment, over 75% of our alumni secure roles within 6 months through our talent partner network." }
          ].each_with_index do |faq, i| %>
            <div class="accordion-item border-bottom py-3">
              <h2 class="accordion-header">
                <button class="accordion-button collapsed bg-transparent fw-bold h5 mb-0 py-4 shadow-none border-0" type="button" data-bs-toggle="collapse" data-bs-target="#faq<%= i %>">
                  <%= faq[:q] %>
                </button>
              </h2>
              <div id="faq<%= i %>" class="accordion-collapse collapse" data-bs-parent="#programsAccordion">
                <div class="accordion-body text-muted lead fs-6 pb-4 pt-0">
                  <%= faq[:a] %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<%# 5. FINAL ENROLLMENT CTA %>
<section class="py-8 bg-primary-custom text-white text-center position-relative overflow-hidden">
  <div class="container position-relative z-1" data-aos="zoom-in">
    <h6 class="text-white-50 fw-bold text-uppercase ls-wide mb-3">Next Intake Starting Soon</h6>
    <h2 class="display-4 fw-bold mb-4 text-white">Your Future in Tech Starts Here</h2>
    <p class="lead text-white-50 mb-5 mx-auto" style="max-width: 750px;">Secure your spot in our upcoming cohort and transform your career path in weeks.</p>
    <div class="d-flex flex-wrap justify-content-center gap-3">
      <%= link_to "Browse Cohorts", programs_path, class: "btn btn-info btn-lg rounded-pill px-5 py-3 fw-bold" %>
      <%= link_to "Ask a Counselor", contact_path, class: "btn btn-outline-light btn-lg rounded-pill px-5 py-3 fw-bold" %>
    </div>
  </div>
</section>
