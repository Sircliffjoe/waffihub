<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Gallery Images</h1>
  <%= link_to new_admin_gallery_image_path, class: "btn btn-primary rounded-pill px-4" do %>
    <i class="bi bi-plus-lg me-2"></i> Add Photo
  <% end %>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="bg-light">
        <tr>
          <th>Image</th>
          <th>Title</th>
          <th>Category</th>
          <th>Event Date</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @gallery_images.each do |gi| %>
          <tr>
            <td>
              <% if gi.image.attached? %>
                <%= image_tag gi.image, class: "rounded border", style: "height: 50px; width: 70px; object-fit: cover;" %>
              <% else %>
                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 70px; height: 50px;">
                  <i class="bi bi-image text-muted"></i>
                </div>
              <% end %>
            </td>
            <td class="fw-bold"><%= gi.title %></td>
            <td><%= gi.category %></td>
            <td class="text-muted small"><%= gi.event_date&.strftime("%B %d, %Y") %></td>
            <td class="text-end">
              <div class="d-flex justify-content-end gap-2">
                <%= link_to edit_admin_gallery_image_path(gi), class: "btn btn-outline-info btn-sm rounded-pill px-3" do %>
                  <i class="bi bi-pencil-square"></i> Edit
                <% end %>
                <%= button_to admin_gallery_image_path(gi), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-outline-danger btn-sm rounded-pill px-3" do %>
                  <i class="bi bi-trash"></i> Delete
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @gallery_images.empty? %>
          <tr>
            <td colspan="5" class="text-center py-5 text-muted">
              No gallery images found. Start by adding one!
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
