<section class="py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-10">
        <nav aria-label="breadcrumb" class="mb-4">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><%= link_to "News", posts_path %></li>
            <li class="breadcrumb-item active"><%= @post.title %></li>
          </ol>
        </nav>
        
        <header class="mb-5 text-center">
          <h1 class="display-4 fw-bold mb-3"><%= @post.title %></h1>
          <div class="text-muted">
            Published on <%= @post.published_at.strftime("%B %d, %Y") %>
          </div>
        </header>

        <% if @post.featured_image.attached? %>
          <%= image_tag @post.featured_image, class: "img-fluid rounded-4 shadow-sm mb-5 w-100", style: "max-height: 500px; object-fit: cover;" %>
        <% end %>

        <div class="rich-text-content lead" style="line-height: 1.8;">
          <%= @post.content %>
        </div>

        <hr class="my-6">
        
        <div class="d-flex justify-content-between align-items-center">
          <div class="share-links">
             <span class="small fw-bold text-muted text-uppercase me-3">Share this:</span>
             <a href="#" class="btn btn-outline-secondary btn-sm rounded-circle"><i class="bi bi-facebook"></i></a>
             <a href="#" class="btn btn-outline-secondary btn-sm rounded-circle"><i class="bi bi-twitter-x"></i></a>
             <a href="#" class="btn btn-outline-secondary btn-sm rounded-circle"><i class="bi bi-linkedin"></i></a>
          </div>
          <%= link_to "Back to News", posts_path, class: "btn btn-link text-decoration-none fw-bold" %>
        </div>
      </div>
    </div>
  </div>
</section>
