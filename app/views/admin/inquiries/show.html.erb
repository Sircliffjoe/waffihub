<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "Inquiries", admin_inquiries_path %></li>
    <li class="breadcrumb-item active">Inquiry from <%= @inquiry.name %></li>
  </ol>
</nav>

<div class="card shadow-sm border-0 mt-4">
  <div class="card-body p-4">
    <h1 class="h4 mb-4">Inquiry Details</h1>
    <div class="row">
      <div class="col-md-6 mb-3">
        <strong>Name:</strong>
        <p><%= @inquiry.name %></p>
      </div>
      <div class="col-md-6 mb-3">
        <strong>Email:</strong>
        <p><%= mail_to @inquiry.email %></p>
      </div>
      <div class="col-12 mb-3">
        <strong>Subject:</strong>
        <p><%= @inquiry.subject %></p>
      </div>
      <div class="col-12 mb-3">
        <strong>Message:</strong>
        <div class="bg-light p-3 rounded">
          <%= simple_format @inquiry.message %>
        </div>
      </div>
    </div>
    <hr>
    <%= button_to "Delete This Inquiry", admin_inquiry_path(@inquiry), method: :delete, class: "btn btn-danger", data: { confirm: "Are you sure?" } %>
  </div>
</div>
