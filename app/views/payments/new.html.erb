<section class="py-5 bg-light" style="min-height: 80vh;">
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-7">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
          <div class="bg-primary-custom p-4 text-white text-center">
            <h2 class="fw-bold mb-0">Checkout</h2>
            <p class="text-white-50 small">Finalize your payment at WaffiHub</p>
          </div>
          <div class="card-body p-4 p-md-5">
            <div class="row g-4">
              <div class="col-md-5 order-md-2">
                <div class="p-4 bg-light rounded-4 sticky-top" style="top: 20px;">
                  <h5 class="fw-bold mb-3 border-bottom pb-2">Order Summary</h5>
                  <% if @program %>
                    <div class="mb-3">
                      <div class="text-muted small">Program</div>
                      <div class="fw-bold"><%= @program.title %></div>
                    </div>
                    <div class="mb-3">
                      <div class="text-muted small">Mode</div>
                      <div class="fw-bold"><%= @program.mode %></div>
                    </div>
                  <% elsif @plan %>
                    <div class="mb-3">
                      <div class="text-muted small">Plan</div>
                      <div class="fw-bold"><%= @plan.name %></div>
                    </div>
                    <div class="mb-3">
                      <div class="text-muted small">Interval</div>
                      <div class="fw-bold"><%= @plan.interval %></div>
                    </div>
                  <% end %>
                  
                  <hr>
                  
                  <div class="d-flex justify-content-between align-items-center mt-3">
                    <span class="fw-bold">Total Due</span>
                    <span class="h4 fw-bold mb-0 text-primary-custom">
                      <%= number_to_currency(@payment.amount, unit: "₦") %>
                    </span>
                  </div>

                  <div class="text-center mt-4 pt-3 border-top">
                    <img src="https://checkout.paystack.com/assets/img/paystack-badge.png" alt="Secure by Paystack" style="max-width: 120px; opacity: 0.7;">
                  </div>
                </div>
              </div>

              <div class="col-md-7 order-md-1">
                <h5 class="fw-bold mb-4">Your Information</h5>
                <%= form_with model: @payment, url: payments_path, data: { turbo: false } do |f| %>
                  <% if @program %>
                    <%= f.hidden_field :program_id, value: @program.id %>
                  <% elsif @plan %>
                    <%= f.hidden_field :plan_id, value: @plan.id %>
                  <% end %>

                  <div class="row g-3">
                    <div class="col-sm-6">
                      <%= f.label :first_name, "First Name *", class: "form-label small fw-bold text-muted" %>
                      <%= f.text_field :first_name, class: "form-control bg-light border-0 py-2", required: true %>
                    </div>
                    <div class="col-sm-6">
                      <%= f.label :last_name, "Last Name *", class: "form-label small fw-bold text-muted" %>
                      <%= f.text_field :last_name, class: "form-control bg-light border-0 py-2", required: true %>
                    </div>
                    <div class="col-12">
                      <%= f.label :email, "Email Address *", class: "form-label small fw-bold text-muted" %>
                      <%= f.email_field :email, class: "form-control bg-light border-0 py-2", required: true, value: (current_user.email if user_signed_in?) %>
                    </div>
                    <div class="col-12">
                      <%= f.label :phone, "Phone Number *", class: "form-label small fw-bold text-muted" %>
                      <%= f.telephone_field :phone, class: "form-control bg-light border-0 py-2", required: true %>
                    </div>
                    <div class="col-12">
                      <%= f.label :address, "Residential Address *", class: "form-label small fw-bold text-muted" %>
                      <%= f.text_area :address, class: "form-control bg-light border-0", rows: 3, required: true %>
                    </div>
                  </div>

                  <div class="mt-5">
                    <%= f.submit "Pay Now", class: "btn btn-primary btn-lg d-block w-100 py-3 rounded-pill fw-bold shadow-lg mb-3" %>
                    <div class="text-center">
                      <% if @program %>
                        <%= link_to "Cancel and return to program", program_path(@program), class: "text-muted small text-decoration-none" %>
                      <% else %>
                        <%= link_to "Cancel and return home", root_path, class: "text-muted small text-decoration-none" %>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
