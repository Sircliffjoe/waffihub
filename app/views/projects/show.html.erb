<%# 1. PREMIUM HERO SECTION %>
<section class="position-relative py-10 py-lg-12 overflow-hidden bg-primary-custom text-white">
  <div class="position-absolute top-0 start-0 w-100 h-100 opacity-50 z-0">
    <% if @project.main_image.attached? %>
      <%= image_tag @project.main_image, class: "w-100 h-100", style: "object-fit: cover; filter: brightness(0.35);", alt: @project.name %>
    <% else %>
      <%= image_tag "shebuilds.jpg", class: "w-100 h-100", style: "object-fit: cover; filter: brightness(0.35);", alt: @project.name %>
    <% end %>
  </div>
  <div class="container position-relative z-1 py-5">
    <div class="row align-items-center">
      <div class="col-lg-8" data-aos="fade-right">
        <% if @project.tagline.present? %>
          <h6 class="text-info fw-bold text-uppercase ls-wide mb-3"><%= @project.tagline %></h6>
        <% end %>
        <h1 class="display-3 fw-bold mb-4 text-white"><%= @project.name %></h1>
        <% if @project.hero_description.present? %>
          <p class="lead text-white-50 mb-5" style="max-width: 650px;"><%= @project.hero_description %></p>
        <% end %>
        <div class="d-flex flex-wrap gap-3">
          <%= link_to "Apply Now", apply_project_path(@project), class: "btn btn-info btn-lg rounded-pill px-5 py-3 fw-bold shadow-lg" %>
          <%= link_to "Partner With Us", partner_project_path(@project), class: "btn btn-outline-light btn-lg rounded-pill px-5 py-3 fw-bold" %>
        </div>
      </div>
    </div>
  </div>
</section>

<%# 2. PROGRAMME AT A GLANCE (QUICK STATS) %>
<% if @project.duration.present? || @project.format.present? || @project.reach.present? || @project.cost.present? %>
<section class="py-8 bg-white" id="about">
  <div class="container">
    <div class="row g-4 overflow-hidden">
      <% [
        { label: "Duration", val: @project.duration, icon: "calendar3" },
        { label: "Format", val: @project.format, icon: "houses" },
        { label: "Reach", val: @project.reach, icon: "geo-alt" },
        { label: "Cost", val: @project.cost, icon: "shield-check" }
      ].select { |i| i[:val].present? }.each_with_index do |item, i| %>
        <div class="col-6 col-lg-3" data-aos="fade-up" data-aos-delay="<%= i * 100 %>">
          <div class="p-4 bg-light rounded-5 text-center h-100 transition-hover border shadow-sm">
            <div class="icon-box-sm bg-primary-custom text-white mx-auto mb-3 rounded-4">
              <i class="bi bi-<%= item[:icon] %>"></i>
            </div>
            <p class="text-muted small fw-bold text-uppercase mb-1"><%= item[:label] %></p>
            <h5 class="fw-bold mb-0 text-primary-custom"><%= item[:val] %></h5>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
<% end %>

<%# 3. THE MISSION & PROBLEM %>
<% if @project.about_description.present? || @project.problem.present? %>
<section class="py-10 bg-light position-relative">
  <div class="container">
    <div class="row g-5 align-items-center">
      <div class="col-lg-6" data-aos="fade-right">
        <div class="rounded-5 overflow-hidden shadow-2xl position-relative p-2 bg-white">
          <% if @project.images.attached? && @project.images.count > 0 %>
            <%= image_tag @project.images.first, class: "img-fluid rounded-4", alt: "Project Detail" %>
          <% else %>
            <img src="https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?auto=format&fit=crop&q=80&w=1200" class="img-fluid rounded-4" alt="Riverine Community">
          <% end %>
        </div>
      </div>
      <div class="col-lg-6" data-aos="fade-left">
        <div class="ps-lg-5">
          <h2 class="display-5 fw-bold mb-4">About <span class="text-info">the Project</span>.</h2>
          <p class="lead text-muted mb-4"><%= @project.about_description %></p>
          
          <div class="mb-5 text-muted">
            <%= @project.problem %>
            <%= @project.solution %>
          </div>

          <% if @project.about_quote.present? %>
            <p class="fw-bold h5 text-primary-custom">"<%= @project.about_quote %>"</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>
<% end %>

<%# 4. LEARNING TRACKS %>
<% if @project.tracks.present? && @project.tracks.is_a?(Array) && @project.tracks.any? %>
<section class="py-10 bg-white overflow-hidden">
  <div class="container">
    <div class="text-center mb-8" data-aos="fade-up">
      <h6 class="text-info fw-bold text-uppercase ls-wide mb-2" style="margin-top: 150px;"><%= @project.curriculum_title.presence || "Components" %></h6>
      <h2 class="display-5 fw-bold"><%= @project.curriculum_title.presence || "Key Tracks" %></h2>
      <% if @project.curriculum_description.present? %>
        <p class="lead text-muted mx-auto" style="max-width: 700px;"><%= @project.curriculum_description %></p>
      <% end %>
    </div>

    <div class="row g-4" style="margin-top: 50px;">
      <% @project.tracks.each_with_index do |track, i| %>
        <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="<%= i * 100 %>">
          <div class="card h-100 border-0 shadow-lg rounded-5 overflow-hidden transition-hover bg-primary-custom text-white p-5">
            <div class="icon-box-sm bg-white text-primary-custom mb-4 rounded-4 shadow-sm">
              <i class="bi bi-<%= track['icon'].presence || 'cpu' %>"></i>
            </div>
            <h4 class="fw-bold text-white mb-3"><%= track['title'] %></h4>
            <p class="text-white-40 small mb-0"><%= track['desc'] %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
<% end %>

<%# 5. HOW IT WORKS TIMELINE %>
<% if @project.timeline_steps.present? && @project.timeline_steps.is_a?(Array) && @project.timeline_steps.any? %>
<section class="py-10 bg-light overflow-hidden">
  <div class="container">
    <div class="row justify-content-center text-center mb-7" data-aos="fade-up">
      <div class="col-lg-8">
        <h2 class="display-5 fw-bold mb-3" style="margin-top: 150px;"><%= @project.timeline_title.presence || "Timeline" %></h2>
        <% if @project.timeline_description.present? %>
          <p class="lead text-muted"><%= @project.timeline_description %></p>
        <% end %>
      </div>
    </div>

    <div class="position-relative">
      <div class="row g-5" style="margin-top: 30px;">
        <% @project.timeline_steps.each_with_index do |step, i| %>
          <div class="col-lg-3 text-center" data-aos="zoom-in" data-aos-delay="<%= i * 100 %>">
            <div class="position-relative mb-4">
              <div class="rounded-pill bg-white shadow-sm fw-bold text-info px-4 py-2 border d-inline-block"><%= step['label'] %></div>
            </div>
            <h5 class="fw-bold mb-2"><%= step['phase'] %></h5>
            <p class="text-muted small mb-0"><%= step['desc'] %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
<% end %>

<%# 6. CALL TO ACTION / PARTNERSHIP %>
<% if @project.partnership_title.present? || @project.partnership_description.present? %>
<section class="py-10 bg-white" id="partner">
  <div class="container">
    <div class="row g-5 align-items-center">
      <div class="col-lg-6" data-aos="fade-right">
        <h2 class="display-5 fw-bold mb-4 text-primary-custom" style="margin-top: 150px;"><%= @project.partnership_title %></h2>
        <p class="lead text-muted mb-5"><%= @project.partnership_description %></p>
        
        <% if @project.partnership_bullets.present? && @project.partnership_bullets.is_a?(Array) && @project.partnership_bullets.any? %>
        <div class="p-5 bg-light rounded-5 border-start border-5 border-info shadow-sm mb-5">
          <ul class="list-unstyled mb-0">
            <% @project.partnership_bullets.each do |bullet| %>
              <li class="d-flex mb-3">
                <div class="text-info me-3"><i class="bi bi-star-fill"></i></div>
                <p class="mb-0 fw-semibold text-primary-custom small"><%= bullet %></p>
              </li>
            <% end %>
          </ul>
        </div>
        <% end %>
        
        <%= link_to "Inquire About Partnership", contact_path, class: "btn btn-primary btn-lg rounded-pill px-5 py-3 fw-bold shadow-lg", style: "margin-bottom: 80px;"%>
      </div>
      <div class="col-lg-6" data-aos="fade-left">
        <div class="rounded-5 overflow-hidden shadow-2xl p-2 bg-light">
          <% if @project.images.attached? && @project.images.count > 1 %>
            <%= image_tag @project.images[1], class: "img-fluid rounded-4", alt: "Partnership" %>
          <% else %>
            <img src="https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&q=80&w=1200" class="img-fluid rounded-4" alt="Women in Training">
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>
<% end %>

<style>
  .shadow-2xl { filter: drop-shadow(0 25px 25px rgba(0,0,0,0.1)); }
  .transition-hover:hover { transform: translateY(-5px); border-color: var(--bs-info) !important; box-shadow: 0 1rem 3rem rgba(0,0,0,0.175) !important; }
  .icon-box-sm { width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
  .ls-wide { letter-spacing: 0.1em; }
</style>
