<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "Projects", admin_projects_path %></li>
    <li class="breadcrumb-item active"><%= @project.name %></li>
  </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
  <h1 class="h3"><%= @project.name %></h1>
  <div>
    <%= link_to "Edit", edit_admin_project_path(@project), class: "btn btn-primary" %>
    <%= link_to "Back", admin_projects_path, class: "btn btn-outline-secondary ms-2" %>
  </div>
</div>

<div class="row">
  <div class="col-md-8">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body">
        <h5 class="mb-3 text-primary">Problem</h5>
        <%= @project.problem %>
        <hr>
        <h5 class="mb-3 text-primary">Solution</h5>
        <%= @project.solution %>
        <hr>
        <h5 class="mb-3 text-primary">Outcome</h5>
        <%= @project.outcome %>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body">
        <h5 class="card-title text-muted mb-3">Project Gallery</h5>
        <div class="row g-2">
          <% @project.images.each do |image| %>
            <div class="col-6">
              <%= image_tag image, class: "img-fluid rounded" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
