<section class="py-5 bg-light" style="min-height: 80vh;">
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-6">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
          <div class="bg-primary-custom p-4 text-white text-center">
            <h2 class="fw-bold mb-0">Checkout</h2>
            <p class="text-white-50 small">Finalize your payment at WaffiHub</p>
          </div>
          <div class="card-body p-4 p-md-5">
            <div class="mb-4 pb-4 border-bottom">
              <h5 class="fw-bold mb-3">Order Summary</h5>
              <% if @program %>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="text-muted"><%= @program.title %></span>
                  <span class="fw-bold"><%= number_to_currency(@program.price, unit: "₦") %></span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="text-muted">Mode</span>
                  <span class="small font-monospace"><%= @program.mode %></span>
                </div>
              <% elsif @plan %>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="text-muted"><%= @plan.name %></span>
                  <span class="fw-bold"><%= number_to_currency(@plan.price, unit: "₦") %></span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="text-muted">Interval</span>
                  <span class="small font-monospace"><%= @plan.interval %></span>
                </div>
              <% end %>
            </div>

            <div class="mb-4">
              <h5 class="fw-bold mb-3">Your Information</h5>
              <div class="p-3 bg-light rounded-3">
                <p class="mb-1 small"><strong>Email:</strong> <%= current_user.email %></p>
                <p class="mb-0 small text-muted">A payment receipt will be sent to this address.</p>
              </div>
            </div>

            <div class="mb-5">
              <div class="d-flex justify-content-between align-items-center mb-4">
                <span class="h5 fw-bold mb-0">Total Due</span>
                <span class="h3 fw-bold mb-0 text-primary-custom">
                  <%= number_to_currency(@payment.amount, unit: "₦") %>
                </span>
              </div>
              
              <%= form_with model: @payment, url: payments_path, data: { turbo: false } do |f| %>
                <% if @program %>
                  <%= f.hidden_field :program_id, value: @program.id %>
                <% elsif @plan %>
                  <%= f.hidden_field :plan_id, value: @plan.id %>
                <% end %>
                <%= f.submit "Pay Now", class: "btn btn-primary btn-lg d-block w-100 py-3 rounded-pill fw-bold shadow-lg mb-3" %>
              <% end %>
              
              <div class="text-center">
                <% if @program %>
                  <%= link_to "Cancel and return to program", program_path(@program), class: "text-muted small text-decoration-none" %>
                <% else %>
                  <%= link_to "Cancel and return home", root_path, class: "text-muted small text-decoration-none" %>
                <% end %>
              </div>
            </div>

            <div class="text-center">
              <img src="https://checkout.paystack.com/assets/img/paystack-badge.png" alt="Secure by Paystack" style="max-width: 150px;">
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
