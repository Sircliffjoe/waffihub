<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Strategic Partners</h1>
  <%= link_to new_admin_partner_path, class: "btn btn-primary rounded-pill px-4" do %>
    <i class="bi bi-plus-lg me-2"></i> Add Partner
  <% end %>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="bg-light">
        <tr>
          <th style="width: 80px;">Pos</th>
          <th>Logo</th>
          <th>Name</th>
          <th>Website</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @partners.each do |partner| %>
          <tr>
            <td class="text-muted fw-bold">#<%= partner.position %></td>
            <td>
              <% if partner.logo.attached? %>
                <%= image_tag partner.logo, class: "rounded border", style: "max-height: 40px; max-width: 100px; object-fit: contain;" %>
              <% else %>
                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 80px; height: 40px;">
                  <i class="bi bi-image text-muted"></i>
                </div>
              <% end %>
            </td>
            <td class="fw-bold"><%= partner.name %></td>
            <td>
              <% if partner.website_url.present? %>
                <a href="<%= partner.website_url %>" target="_blank" class="text-decoration-none small text-primary-custom">
                  <%= partner.website_url.truncate(30) %> <i class="bi bi-box-arrow-up-right ms-1" style="font-size: 0.75rem;"></i>
                </a>
              <% else %>
                <span class="text-muted small">No URL</span>
              <% end %>
            </td>
            <td class="text-end">
              <div class="d-flex justify-content-end gap-2">
                <%= link_to edit_admin_partner_path(partner), class: "btn btn-outline-info btn-sm rounded-pill px-3" do %>
                  <i class="bi bi-pencil-square"></i> Edit
                <% end %>
                <%= button_to admin_partner_path(partner), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-outline-danger btn-sm rounded-pill px-3" do %>
                  <i class="bi bi-trash"></i> Delete
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @partners.empty? %>
          <tr>
            <td colspan="5" class="text-center py-5 text-muted">
              No partners found. Start by adding one!
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
