      <% [
        { icon: "lightning-charge", title: "Fast & Reliable Internet", desc: "High-speed connectivity for seamless work." },
        { icon: "calendar-check", title: "Flexible Plans", desc: "Choose daily, weekly, or monthly subscriptions." },
        { icon: "gem", title: "Comfortable Spaces", desc: "Environment designed for your comfort and productivity." },
        { icon: "people", title: "Community Networking", desc: "Connect with like-minded professionals." },
        { icon: "shield-check", title: "Secure Access", desc: "Work in a secured and safe environment." }
      ].each_with_index do |item, i| %>
